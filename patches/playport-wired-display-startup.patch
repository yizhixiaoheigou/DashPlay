--- /dev/null
+++ b/server/src/test/kotlin/com/playport/server/WiredDisplayStartupTest.kt
@@ -0,0 +1,102 @@
+package com.playport.server
+
+import com.shilapi.xcertplay.airplay.*
+import java.net.Socket
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class WiredDisplayStartupTest {
+    @get:Rule val temp = TemporaryFolder()
+
+    private fun field(owner: Any, name: String) = owner.javaClass.getDeclaredField(name).also { it.isAccessible = true }
+    private fun set(owner: Any, name: String, value: Any?) = field(owner, name).set(owner, value)
+
+    private fun run(block: (CarPlayServer, WiredRunResources, ConfigStore) -> Unit) {
+        val root = temp.newFolder().toPath()
+        val store = ConfigStore(root.resolve("state"))
+        CarPlayServer(ServerConfig(identityDir = root, stateDir = root.resolve("state"),
+            bindAddress = "127.0.0.1", wireless = false), store).use { server ->
+            val bootstrap = WiredBootstrap(server, root.resolve("unused-helper"))
+            val resources = WiredRunResources(AutoCloseable {})
+            set(bootstrap, "link", resources)
+            set(server, "wired", bootstrap)
+            server.setCablePhone(true)
+            block(server, resources, store)
+        }
+    }
+
+    private fun negotiating(server: CarPlayServer): AirPlaySession {
+        val listener = field(server, "listener").get(server) as AirPlaySessionListener
+        return AirPlaySession(Socket(), server.airPlayConfig, server.identity, PairingStore(), null,
+            listener, object : AirPlayMediaHandler {}).also {
+            set(server, "wiredSession", it)
+            set(server, "activeSession", it)
+        }
+    }
+
+    @Test fun newShapeBeforeAirPlayKeepsTheUsbHandshakeAndUpdatesNextConfig() = run { server, resources, store ->
+        // Historical manual switch: start-session sent, then the viewer changes shape before AirPlay arrives.
+        val result = server.applyDisplay(DisplayRequest(2560, 1676, 60, 100, hevc = true, reason = "shape"))
+        assertNull(result.error)
+        assertFalse(result.deferred)
+        assertFalse("display update must not tear down the in-flight USB handshake", resources.closed)
+        assertEquals(2560, server.airPlayConfig.main.widthPixels)
+        assertEquals(1676, server.airPlayConfig.main.heightPixels)
+        assertTrue(server.airPlayConfig.hevc)
+        assertEquals(2560, store.load()!!.display.width)
+    }
+
+    @Test fun latestRequestBeforeAirPlayReplacesPendingAndKeepsUsb() = run { server, resources, store ->
+        server.display.defer(DisplayRequest(1280, 720))
+        val areas = listOf(ViewArea(1920, 1080), ViewArea(1280, 1080))
+        server.applyDisplay(DisplayRequest(1920, 1080, areas = areas, area = 1, defer = true))
+        assertNull(server.display.pending)
+        assertEquals(areas, server.display.areas)
+        assertEquals(1, server.airPlayConfig.main.initialViewArea)
+        assertEquals(1, store.load()!!.display.area)
+        assertFalse(resources.closed)
+        server.applyDisplay(DisplayRequest(1920, 1080, areas = areas, area = 0))
+        assertEquals(0, server.airPlayConfig.main.initialViewArea)
+        assertFalse(resources.closed)
+    }
+
+    @Test fun acceptedButNotYetLiveSessionStillRestartsForNewShape() = run { server, resources, _ ->
+        val session = negotiating(server)
+        assertFalse(server.wiredSessionActive())
+        server.applyDisplay(DisplayRequest(2560, 1676))
+        assertTrue("accepted session has already captured the old display", resources.closed)
+        assertNull(field(server, "activeSession").get(server))
+        session.close()
+    }
+
+    @Test fun liveSessionStillRestartsForImmediateChange() = run { server, resources, _ ->
+        val session = negotiating(server)
+        (field(server, "listener").get(server) as AirPlaySessionListener).onSessionActive(session)
+        assertTrue(server.wiredSessionActive())
+        server.applyDisplay(DisplayRequest(2560, 1676))
+        assertTrue(resources.closed)
+        assertFalse(server.wiredSessionActive())
+    }
+
+    @Test fun deferredChangeWaitsForLiveSessionToEnd() = run { server, resources, _ ->
+        val session = negotiating(server)
+        (field(server, "listener").get(server) as AirPlaySessionListener).onSessionActive(session)
+        val oldWidth = server.display.width
+        val result = server.applyDisplay(DisplayRequest(2560, 1676, defer = true))
+        assertTrue(result.deferred)
+        assertEquals(oldWidth, server.display.width)
+        assertFalse(resources.closed)
+        session.close()
+        assertEquals(2560, server.display.width)
+    }
+
+    @Test fun invalidDisplayCannotAlterStartup() = run { server, resources, store ->
+        val before = server.airPlayConfig
+        assertNotNull(server.applyDisplay(DisplayRequest(1, 1)).error)
+        assertEquals(before.main, server.airPlayConfig.main)
+        assertNull(store.load())
+        assertFalse(resources.closed)
+    }
+}
