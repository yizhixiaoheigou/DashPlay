@@ -0,0 +1,28 @@
+package com.playport.server
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class WirelessSessionRecoveryTest {
+    @Test fun liveOwnerHasOnlyOneAttemptAndNegotiationCannotRenewIt() {
+        val r = WirelessSessionRecovery()
+        r.ended(0); assertNull(r.candidate(1))
+        r.active("a"); r.ended(1000)
+        assertEquals("a", r.candidate(2000))
+        assertFalse(r.take(2000, "b"))
+        assertTrue(r.take(2000, "a")); assertFalse(r.take(2001, "a"))
+        r.ended(3000); assertNull(r.candidate(3001))
+    }
+    @Test fun grantExpiresAndIntentionalDisconnectCancelsBothStates() {
+        val r = WirelessSessionRecovery()
+        r.active("a"); r.ended(1000); assertNull(r.candidate(46000))
+        r.active("a"); r.cancel(); r.ended(50000); assertNull(r.candidate(50001))
+        r.active("a"); r.ended(60000); r.cancel(); assertNull(r.candidate(60001))
+    }
+    @Test fun newLiveOwnerReplacesGrantAndWiredCannotArmIt() {
+        val r = WirelessSessionRecovery()
+        r.active("a"); r.ended(1000); r.active("b"); assertNull(r.candidate(2000))
+        r.ended(3000); assertTrue(r.take(4000, "b"))
+        r.active(null); r.ended(5000); assertNull(r.candidate(5001))
+    }
+}
