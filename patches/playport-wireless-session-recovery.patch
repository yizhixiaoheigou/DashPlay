@@ -0,0 +1,71 @@
+package com.playport.server
+
+import com.shilapi.xcertplay.airplay.*
+import java.net.Socket
+import java.nio.file.Files
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class WirelessSessionRecoveryIntegrationTest {
+    @get:Rule val temp = TemporaryFolder()
+    private val a = "02:00:00:00:00:0A"
+    private val b = "02:00:00:00:00:0B"
+    private fun field(s: CarPlayServer, n: String) = CarPlayServer::class.java.getDeclaredField(n).also { it.isAccessible = true }
+    private fun set(s: CarPlayServer, n: String, v: Any?) = field(s,n).set(s,v)
+    private fun listener(s: CarPlayServer) = field(s,"listener").get(s) as AirPlaySessionListener
+    private fun session(s: CarPlayServer) = AirPlaySession(Socket(), s.airPlayConfig, s.identity, PairingStore(), null, listener(s), object: AirPlayMediaHandler {})
+    private fun pending(s: CarPlayServer) = (field(s,"sessionRecovery").get(s) as WirelessSessionRecovery).candidate(System.nanoTime()/1_000_000)
+    private fun recover(s: CarPlayServer): Boolean {
+        val m = CarPlayServer::class.java.getDeclaredMethod("recoverWirelessSession", Long::class.javaPrimitiveType)
+        m.isAccessible=true; return m.invoke(s,System.nanoTime()/1_000_000) as Boolean
+    }
+    private fun run(allowed: Boolean = true, block: (CarPlayServer) -> Unit) {
+        val root=temp.newFolder().toPath()
+        val helper=root.resolve("presence.py")
+        Files.writeString(helper,"import sys\nif sys.argv[1] == 'allowed' and ${if (allowed) "True" else "False"}: print('ok')\nelse: sys.exit(1)\n")
+        CarPlayServer(ServerConfig(identityDir=root, stateDir=root.resolve("state"), bindAddress="127.0.0.1",wireless=true)).use {
+            set(it,"presenceHelper",helper.toString());set(it,"selectedPhone",a);block(it)
+        }
+    }
+    @Test fun vanishedWifiOwnerIsInvitedOnceWithoutPresence() = run { s ->
+        val live=session(s);listener(s).onSessionActive(live);live.close()
+        assertEquals(a,pending(s));assertTrue(recover(s));assertFalse(recover(s))
+        assertEquals(a,field(s,"invitedPhone").get(s))
+    }
+    @Test fun pausedOwnerCannotBeInvited() = run(false) { s ->
+        val live=session(s);listener(s).onSessionActive(live);live.close()
+        assertFalse(recover(s));assertNull(pending(s))
+    }
+    @Test fun manualDisconnectDoesNotArmRecovery() = run { s ->
+        val live=session(s);listener(s).onSessionActive(live)
+        val m=CarPlayServer::class.java.getDeclaredMethod("disconnectPhone",String::class.java);m.isAccessible=true
+        assertEquals(true,m.invoke(s,a));assertNull(pending(s));assertFalse(recover(s))
+    }
+    @Test fun cableTakeoverCancelsOwnerBeforeClose() = run { s ->
+        val live=session(s);listener(s).onSessionActive(live)
+        s.setCablePhone(true);assertNull(pending(s));assertFalse(recover(s))
+    }
+    @Test fun lateCloseAndChangedSelectionCannotInvitePreviousOwner() = run { s ->
+        val old=session(s);listener(s).onSessionActive(old)
+        set(s,"selectedPhone",b);val next=session(s);listener(s).onSessionActive(next)
+        old.close();assertNull(pending(s));next.close();assertEquals(b,pending(s))
+        set(s,"selectedPhone",a);assertFalse(recover(s));assertNull(pending(s))
+    }
+    @Test fun displayRestartCancelsAutomaticLossRecovery() = run { s ->
+        val live=session(s);listener(s).onSessionActive(live)
+        s.applyDisplay(DisplayRequest(1024,600))
+        assertNull(pending(s));assertFalse(recover(s))
+    }
+    @Test fun anotherNegotiationDoesNotConsumeThePendingGrant() = run { s ->
+        val live=session(s);listener(s).onSessionActive(live);live.close()
+        val negotiating=session(s);set(s,"activeSession",negotiating)
+        assertFalse(recover(s));assertEquals(a,pending(s))
+        negotiating.close();assertTrue(recover(s))
+    }
+    @Test fun negotiationOnlyAndWiredSessionDoNotArmRecovery() = run { s ->
+        val negotiation=session(s);set(s,"activeSession",negotiation);negotiation.close();assertNull(pending(s))
+        val wired=session(s);set(s,"wiredSession",wired);listener(s).onSessionActive(wired);wired.close();assertNull(pending(s))
+    }
+}
