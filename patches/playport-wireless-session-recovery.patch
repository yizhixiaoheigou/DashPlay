+++ b/server/src/main/kotlin/com/playport/server/WirelessSessionRecovery.kt
@@ -0,0 +1,28 @@
+package com.playport.server
+
+/** One bounded invitation for the owner of a previously active wireless session.
+ * A failed negotiation cannot renew it; intentional disconnects cancel both owner and grant.
+ */
+internal class WirelessSessionRecovery {
+    private var owner: String? = null
+    private var pending: String? = null
+    private var expires = 0L
+
+    @Synchronized fun active(phone: String?) { cancel(); owner = phone }
+    @Synchronized fun ended(now: Long) {
+        val phone = owner ?: return
+        owner = null
+        pending = phone
+        expires = now + 45_000L
+    }
+    @Synchronized fun candidate(now: Long): String? {
+        if (now >= expires) pending = null
+        return pending
+    }
+    @Synchronized fun take(now: Long, phone: String): Boolean {
+        if (candidate(now) != phone) return false
+        pending = null
+        return true
+    }
+    @Synchronized fun cancel() { owner = null; pending = null; expires = 0L }
+}
