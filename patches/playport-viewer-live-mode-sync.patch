+const main = readFileSync(new URL('./src/main.ts', import.meta.url), 'utf8');
+const source = main.slice(main.indexOf('const TESLA_SOUND_LABELS'), main.indexOf('// Every visible slider'));
+const elements = ['audioOutput','audioOutputHint','audioOffCarPlay','audioMixHint'].map(key => ({ dataset: { i18n:key } }));
+const updates = [], passive = [];
+let response = { tesla:true, carMusic:true, carVoice:true };
+const context = vm.createContext({
+  teslaMode:false, carMusic:false, carVoice:false, boxFlags:{}, voices:new Set(), promptGain:()=>1,
+  audio:{ updateMode:value=>updates.push(value) }, media:{ setPassive:value=>passive.push(value) },
+  document:{ querySelectorAll: selector => elements.filter(e => selector.includes(`"${e.dataset.i18n}"`)) },
+  fetch:async()=>({ok:true,json:async()=>response}), renderAudioMix(){}, render(){}, loadAudioRoutes(){},
+});
+vm.runInContext(transpile(source), context);
+await vm.runInContext('syncBoxMode()', context);
+assert.equal(context.teslaMode,true); assert.equal(updates.at(-1).dropMusic,true);
+assert.equal(elements[0].dataset.i18n,'teslaNavOutput');
+response={tesla:false,carMusic:false,carVoice:false};
+await vm.runInContext('syncBoxMode()', context);
+assert.equal(context.teslaMode,false); assert.equal(updates.at(-1).dropMusic,false);
+assert.equal(elements[0].dataset.i18n,'audioOutput','reverse switch restores normal labels');
+assert.deepEqual(passive,[true,false]);
+assert.equal(context.boxFlags.playportTeslaMode,false,'microphone and other consumers follow live mode');
+// Two reconnects: a late response from the old connection must not overwrite the new mode.
+const pending=[];context.fetch=()=>new Promise(resolve=>pending.push(resolve));
+const first=vm.runInContext('syncBoxMode()',context), second=vm.runInContext('syncBoxMode()',context);
+pending[1]({ok:true,json:async()=>({tesla:true,carMusic:true})});await second;
+pending[0]({ok:true,json:async()=>({tesla:false,carMusic:false})});await first;
+assert.equal(context.teslaMode,true);
+context.fetch=async()=>({ok:true,json:async()=>null});await vm.runInContext('syncBoxMode()',context);
+assert.equal(context.teslaMode,true,'invalid response keeps current mode');
+// Media-card ownership changes in both directions without leaving old hardware-key handlers behind.
+const actions={}, mediaSession={setActionHandler:(name,fn)=>{actions[name]=fn;},setPositionState(){}};
+Object.defineProperty(globalThis,'navigator',{value:{mediaSession},configurable:true});
+const code=transpile(readFileSync(new URL('./src/media-session.ts',import.meta.url),'utf8'));
+const {SystemMedia}=await import(`data:text/javascript;base64,${Buffer.from(code).toString('base64')}`);
+const media=new SystemMedia(()=>{},()=>{},()=>{},true);
+assert.equal(media.supported,false);
+media.setPassive(false);assert.equal(typeof actions.play,'function');
+media.setPassive(true);assert.equal(actions.play,null);assert.equal(mediaSession.playbackState,'none');
+media.setPassive(false);assert.equal(typeof actions.play,'function');
+console.log('Live mode: bidirectional labels/audio flags/media ownership, stale/invalid responses passed');
+// Audio config may arrive before the settings fetch: switching away from Tesla must restore that stream.
+const node=()=>({gain:{value:1},threshold:{},knee:{},ratio:{},attack:{},release:{},connect(){},disconnect(){}});
+class Context {
+  state='running';destination={};sampleRate=48000;
+  createGain(){return node();} createDynamicsCompressor(){return node();}
+  async resume(){this.state='running';} async suspend(){this.state='suspended';}
+}
+const audioContext=vm.createContext({ AudioContext:Context, window:{clearTimeout(){},setTimeout(){return 1;}},
+  AudioCodec:{Lpcm:1,AacLc:2,Opus:3}, MusicOutput:{supported:()=>false},
+  baseGain:(name,boost)=>name==='default'?boost:1,clampPercent:(_,v)=>v,effectiveGain:(base,percent)=>base*percent/100,
+  pageDropsMusic:(tesla,name)=>tesla&&name==='media', performance:{now:()=>0},
+});
+const audioSource=readFileSync(new URL('./src/audio.ts',import.meta.url),'utf8').replace(/^import .*;$/gm,'').replace('export class AudioEngine','class AudioEngine');
+vm.runInContext(transpile(audioSource),audioContext);
+vm.runInContext(`engine=new AudioEngine(()=>{}, {dropMusic:true,idleClose:true});
+  engine.handleConfig({streamType:100,name:'media',codec:1,sampleRate:48000,channels:2});`,audioContext);
+assert.equal(vm.runInContext('engine.activeStreamNames().length',audioContext),0);
+vm.runInContext('engine.updateMode({dropMusic:false,idleClose:false})',audioContext);
+assert.equal(vm.runInContext('engine.activeStreamNames()[0]',audioContext),'media');
+vm.runInContext('engine.updateMode({dropMusic:true,idleClose:true})',audioContext);
+assert.equal(vm.runInContext('engine.activeStreamNames().length',audioContext),0);
+vm.runInContext('engine.stopStream(100); engine.updateMode({dropMusic:false})',audioContext);
+assert.equal(vm.runInContext('engine.activeStreamNames().length',audioContext),0,'ended streams must not be resurrected');
+console.log('Live audio: config-before-settings recovery, Tesla drop, ended stream cleanup passed');
