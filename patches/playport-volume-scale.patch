 export function clampPercent(name: string, percent: number): number {
   return Math.min(maxPercent(name), Math.max(0, Number.isFinite(percent) ? percent : 100));
+}
+
+/** A common slider position: 0 is muted, 100 is this category's existing maximum. */
+export function volumePercent(name: string, percent: number): number {
+  return clampPercent(name, percent) / maxPercent(name) * 100;
+}
+
+/** Translate the UI position back to the existing gain/storage format. */
+export function gainPercent(name: string, volume: number): number {
+  if (!Number.isFinite(volume)) return 100;
+  return Math.min(100, Math.max(0, volume)) / 100 * maxPercent(name);
 }
 
 /** What the audio engine applies: the base times the percentage, capped like the old ?promptgain= (×8). */
