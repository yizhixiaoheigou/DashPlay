+package com.playport.server
+
+import java.nio.file.Files
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import org.junit.Assert.*
+import org.junit.Test
+
+class UsbPrepareTest {
+    @Test fun usbModeChangeWaitsForWirelessTeardownToFinish() {
+        val dir = Files.createTempDirectory("usb-prepare")
+        val changed = dir.resolve("configured")
+        val helper = dir.resolve("helper.py")
+        Files.writeString(helper, """
+            import os, sys
+            from pathlib import Path
+            if os.environ.get('CARPLAY_USB_STATE_ACK') == '1':
+                print('usb prepare test-phone', file=sys.stderr, flush=True)
+                assert sys.stdin.buffer.read(4) == b'RDY!'
+            else:
+                print('usb iphone test-phone', file=sys.stderr, flush=True)
+            Path('${changed}').write_text('configured')
+            print('ncm testtap 3 02:00:00:00:00:01', file=sys.stderr, flush=True)
+            sys.stdin.buffer.read()
+        """.trimIndent())
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val pipe = UsbBridgePipe.start(helper) {
+            entered.countDown()
+            check(release.await(3, TimeUnit.SECONDS))
+        }
+        try {
+            assertTrue(entered.await(2, TimeUnit.SECONDS))
+            assertNull(pipe.awaitNcm(150))
+            assertFalse("USB mode changed before wireless teardown finished", Files.exists(changed))
+            release.countDown()
+            assertEquals("testtap", pipe.awaitNcm(2000))
+            assertTrue(Files.exists(changed))
+        } finally {
+            release.countDown()
+            pipe.close()
+            dir.toFile().deleteRecursively()
+        }
+    }
+
+    @Test fun oldHelperReceivesNoExtraAcknowledgementBytes() {
+        val helper = Files.createTempFile("usb-legacy", ".py")
+        Files.writeString(helper, """
+            import sys, struct
+            print('usb iphone test-phone', file=sys.stderr, flush=True)
+            print('ncm testtap 3 02:00:00:00:00:01', file=sys.stderr, flush=True)
+            size = struct.unpack('>I', sys.stdin.buffer.read(4))[0]
+            data = sys.stdin.buffer.read(size)
+            sys.stdout.buffer.write(struct.pack('>I', len(data)) + data)
+            sys.stdout.buffer.flush()
+            sys.stdin.buffer.read()
+        """.trimIndent())
+        val pipe = UsbBridgePipe.start(helper)
+        try {
+            assertEquals("testtap", pipe.awaitNcm(2000))
+            pipe.write(byteArrayOf(1, 2, 3), 1000)
+            assertArrayEquals(byteArrayOf(1, 2, 3), pipe.read(2000))
+        } finally {
+            pipe.close()
+            Files.deleteIfExists(helper)
+        }
+    }
+}
