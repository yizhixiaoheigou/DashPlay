+package com.playport.server
+
+import java.nio.file.Files
+import org.junit.Assert.*
+import org.junit.Test
+
+class KeepWirelessTest {
+    @Test fun pluggingInPreservesWirelessButExplicitCableSelectionOverridesIt() {
+        val dir = Files.createTempDirectory("keep-wireless")
+        val role = CableRole(dir.resolve("cable-off"), false)
+        try {
+            role.init()
+            assertTrue(role.keepWirelessOnPlug(wirelessActive=true, cableRequested=false))
+            assertFalse(role.carPlayOnCable())
+            assertEquals("available", CableRole.wiredRow(true, role.carPlayOnCable(), false, false))
+            assertTrue(role.turnOn())
+            assertFalse(role.keepWirelessOnPlug(wirelessActive=true, cableRequested=true))
+            assertTrue(role.carPlayOnCable())
+            assertEquals("starting", CableRole.wiredRow(true, role.carPlayOnCable(), false, false))
+        } finally { dir.toFile().deleteRecursively() }
+    }
+
+    @Test fun unplugClearsTheTemporaryChoiceAndNoWirelessMeansDirectWiredStartup() {
+        val dir = Files.createTempDirectory("keep-wireless-unplug")
+        val role = CableRole(dir.resolve("cable-off"), false)
+        try {
+            assertTrue(role.keepWirelessOnPlug(wirelessActive=true, cableRequested=false))
+            role.unplugged()
+            assertTrue(role.carPlayOnCable())
+            assertFalse(role.keepWirelessOnPlug(wirelessActive=false, cableRequested=false))
+            assertTrue(role.carPlayOnCable())
+        } finally { dir.toFile().deleteRecursively() }
+    }
+}
