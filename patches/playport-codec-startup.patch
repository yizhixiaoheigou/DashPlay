+// Test the generated viewer's real startup ordering without a box, phone or browser preferences.
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import ts from 'typescript';
+const root = new URL('./', import.meta.url);
+const source = readFileSync(new URL('src/main.ts', root), 'utf8');
+const parsed = ts.createSourceFile('main.ts', source, ts.ScriptTarget.Latest, true);
+const functions = ['startViewer', 'probeHevc', 'wantHevc', 'autoTarget', 'clearInitialVideoWait', 'expectInitialVideo', 'acceptInitialVideoConfig'].map(name => {
+  const node = parsed.statements.find(n => ts.isFunctionDeclaration(n) && n.name?.text === name);
+  assert.ok(node, `missing ${name}`); return node.getText(parsed);
+}).join('\n');
+const transpile = text => ts.transpileModule(text, { compilerOptions: {
+  target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext,
+} }).outputText;
+const mathSource = transpile(readFileSync(new URL('src/display-fit.ts', root), 'utf8'));
+const math = await import(`data:text/javascript;base64,${Buffer.from(mathSource).toString('base64')}`);
+const fixture = `
+const {windowResolution,suggestedResolution,aspectChanged,sameStream}=math;
+let token='fixture',hevcDecodes=true,hevcSupport=Promise.resolve(),pageFastDecoder=false,codec='auto';
+let current,display,lastAutoTarget='',auto=true,wantFullscreen=false,events=[];
+let initialVideoTarget=null,initialVideoAccepted=true,initialVideoTimer=0;
+const VideoCodec={H264:1,H265:2},send=m=>events.push({kind:m.type});
+const fastDecoder=()=>pageFastDecoder;
+const flags=new Map(), readFlag=k=>flags.get(k)||'',el=()=>({value:codec});
+const screen={clientWidth:1300,clientHeight:850},document={hidden:false,fullscreenElement:null};
+const timers=new Map();let timerId=0;
+const window={devicePixelRatio:2,setTimeout:fn=>{timers.set(++timerId,fn);return timerId},clearTimeout:id=>timers.delete(id)};
+const autoFitOn=()=>auto,performanceOn=()=>false;
+const fetchDisplay=async()=>current;
+const saveDisplay=async(target,how)=>{events.push({kind:'save',target,reason:how.reason});current=display=target;return true};
+const connection={connect:()=>events.push({kind:'connect'})};
+let VideoDecoder={isConfigSupported:async()=>({supported:true})};
+${functions}
+function reset() {
+ clearInitialVideoWait();
+ current={width:1300,height:850,fps:60,uiScale:100,hevc:false,areas:[],area:0};
+ events=[];flags.clear();hevcDecodes=true;pageFastDecoder=false;codec='auto';auto=true;document.hidden=false;lastAutoTarget='';
+}
+reset(); await startViewer();
+assert.deepEqual(events.map(e=>e.kind),['save','connect'],'select supported HEVC before opening the viewer socket');
+assert.equal(events[0].target.hevc,true);assert.equal(events[0].reason,'initial');
+assert.equal(events[0].target.width,1300,'codec choice must not require a resolution change');
+assert.equal(acceptInitialVideoConfig({codec:1,width:1300,height:850}),false,'cached H264 config must not reach the decoder');
+assert.equal(initialVideoAccepted,false,'frames following rejected config must be ignored');
+assert.equal(acceptInitialVideoConfig({codec:2,width:1300,height:638}),false,'cached wrong-size HEVC must also be ignored');
+assert.equal(acceptInitialVideoConfig({codec:2,width:1300,height:850}),true);
+assert.equal(initialVideoAccepted,true);assert.equal(initialVideoTarget,null);
+assert.equal(timers.size,0,'matching config clears the startup timeout');
+// Reload on the resulting HEVC stream must not interrupt it again.
+events=[];await startViewer();assert.deepEqual(events,[{kind:'connect'}]);
+for(const reason of ['unsupported','failed','explicit-h264']) {
+ reset();if(reason==='unsupported')hevcDecodes=false;
+ if(reason==='failed')flags.set('f50-hevc-failed','1');
+ if(reason==='explicit-h264')codec='h264';
+ await startViewer();assert.deepEqual(events,[{kind:'connect'}],reason);
+}
+reset();current={...current,width:2560,height:1674,hevc:true};await startViewer();
+assert.deepEqual(events,[{kind:'connect'}],'a fresh browser must retain an already compatible high-resolution HEVC stream');
+assert.equal(current.width,2560);
+reset();current={...current,width:1300,height:638};await startViewer();
+assert.equal(events.filter(e=>e.kind==='save').length,1,'shape and codec must be one request');
+assert.equal(events[0].target.height,850);assert.equal(events[0].target.hevc,true);
+reset();auto=false;current={...current,width:1920,height:1080};await startViewer();
+assert.equal(events[0].target.width,1920,'custom dimensions remain authoritative');
+assert.equal(events[0].target.height,1080);assert.equal(events[0].target.hevc,true);
+reset();current=null;await startViewer();assert.deepEqual(events,[{kind:'connect'}],'unavailable display API must not prevent connection');
+reset();document.hidden=true;await startViewer();assert.deepEqual(events,[{kind:'connect'}],'hidden pages must not negotiate');
+reset();let finishProbe;hevcSupport=new Promise(resolve=>{finishProbe=resolve});
+const starting=startViewer();await Promise.resolve();assert.equal(events.length,0,'wait for codec capability before choosing a stream');
+finishProbe();await starting;assert.deepEqual(events.map(e=>e.kind),['save','connect']);
+clearInitialVideoWait();
+expectInitialVideo(current);for(const timer of [...timers.values()])timer();
+assert.equal(initialVideoAccepted,true);assert.equal(initialVideoTarget,null);assert.equal(events.at(-1).kind,'keyframe');
+assert.equal(await probeHevc(),true);assert.equal(timers.size,0);
+VideoDecoder={isConfigSupported:async()=>{throw new Error('probe rejected')}};
+assert.equal(await probeHevc(),false);assert.equal(timers.size,0);
+let finishLate;VideoDecoder={isConfigSupported:()=>new Promise(resolve=>{finishLate=resolve})};
+const timed=probeHevc();for(const timer of [...timers.values()])timer();
+assert.equal(await timed,false,'a hung capability probe has a bounded wait');
+finishLate({supported:true});await Promise.resolve();assert.equal(timers.size,0);
+VideoDecoder=undefined;assert.equal(await probeHevc(),false);
+console.log('CODEC_STARTUP_OK: fresh HEVC, explicit choice, failure fallback, retained resolution, single pre-connect request, timeout and reload');
+`;
+const AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;
+await new AsyncFunction('math','assert',transpile(fixture))(math,assert);
