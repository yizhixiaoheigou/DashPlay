+/** Select the codec before subscribing to cached video, so entry cannot flash H264 then renegotiate.
+ * Keep an existing stream's resolution when its shape fits; speed learning must not lower or double it. */
+async function startViewer(): Promise<void> {
+  if (!token) return;
+  try {
+    await hevcSupport;
+    if (!document.hidden) {
+      const current = await fetchDisplay();
+      if (current) {
+        display = current;
+        const shape = autoTarget(), hevc = wantHevc();
+        const fitWindow = autoFitOn() && !(wantFullscreen && !document.fullscreenElement);
+        const next = fitWindow && ((current.areas?.length ?? 0) > 0 || aspectChanged(current, shape))
+          ? { ...current, ...shape, areas: [], area: 0, hevc } : { ...current, hevc };
+        // Do not undo the same-shape resolution we just retained on the first frame/resize callback.
+        if (fitWindow) lastAutoTarget = `${shape.width}x${shape.height}${hevc ? '-h265' : ''}`;
+        if (!sameStream(current, next)) {
+          expectInitialVideo(next);
+          if (!(await saveDisplay(next, { reason: 'initial' }))) clearInitialVideoWait();
+        }
+      }
+    }
+  } finally { connection.connect(); }
+}
