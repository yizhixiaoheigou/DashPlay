--- /dev/null
+++ b/server/src/test/kotlin/com/playport/server/ActivePhonePresenceTest.kt
@@ -0,0 +1,116 @@
+package com.playport.server
+
+import com.shilapi.xcertplay.airplay.*
+import java.net.Socket
+import java.nio.file.Files
+import java.nio.file.Path
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class ActivePhonePresenceTest {
+    @get:Rule val temp = TemporaryFolder()
+    private val phone = "02:00:00:00:00:01"
+    private fun field(server: CarPlayServer, name: String) = CarPlayServer::class.java.getDeclaredField(name).also { it.isAccessible = true }
+    private fun set(server: CarPlayServer, name: String, value: Any?) = field(server, name).set(server, value)
+    private fun listener(server: CarPlayServer) = field(server, "listener").get(server) as AirPlaySessionListener
+    private fun session(server: CarPlayServer) = AirPlaySession(Socket(), server.airPlayConfig, server.identity, PairingStore(), null, listener(server), object: AirPlayMediaHandler {})
+    private fun refresh(server: CarPlayServer) {
+        CarPlayServer::class.java.getDeclaredMethod("refreshWirelessPresence").also { it.isAccessible = true }.invoke(server)
+    }
+    private fun withServer(block: (CarPlayServer, Path) -> Unit) {
+        val root = temp.newFolder().toPath()
+        Files.writeString(root.resolve("presence.py"), """
+            import pathlib, sys, time
+            root = pathlib.Path(__file__).parent
+            command = sys.argv[1]
+            with (root / 'commands').open('a') as out: out.write(command + '\n')
+            if command == 'active':
+                if (root / 'hold').exists():
+                    (root / 'publishing').touch()
+                    deadline = time.monotonic() + 4
+                    while (root / 'hold').exists() and time.monotonic() < deadline:
+                        time.sleep(.01)
+                fail = root / 'fail-once'
+                if fail.exists():
+                    fail.unlink()
+                    sys.exit(1)
+                (root / 'active').write_text(sys.argv[2])
+            elif command == 'idle':
+                (root / 'active').write_text('')
+            else:
+                sys.exit(1)  # ARP learning fails throughout this reproduction.
+            print('ok')
+        """.trimIndent())
+        CarPlayServer(ServerConfig(identityDir = root, stateDir = root.resolve("state"), bindAddress = "127.0.0.1", wireless = true)).use {
+            set(it, "presenceHelper", root.resolve("presence.py").toString())
+            set(it, "selectedPhone", phone)
+            block(it, root)
+        }
+    }
+    @Test fun liveSessionIsPublishedEvenWhenArpLearningFails() = withServer { server, root ->
+        val live = session(server)
+        listener(server).onSessionActive(live)
+        refresh(server); refresh(server)
+        assertEquals(phone, Files.readString(root.resolve("active")))
+        assertEquals(1, Files.readAllLines(root.resolve("commands")).count { it == "active" })
+        live.close()
+        refresh(server)
+        assertEquals("", Files.readString(root.resolve("active")))
+    }
+    @Test fun failedPublicationIsRetried() = withServer { server, root ->
+        Files.writeString(root.resolve("fail-once"), "")
+        listener(server).onSessionActive(session(server))
+        refresh(server)
+        assertFalse(Files.exists(root.resolve("active")))
+        refresh(server)
+        assertEquals(phone, Files.readString(root.resolve("active")))
+    }
+    @Test fun negotiationAndWiredSessionsAreNotWirelessOwners() = withServer { server, root ->
+        val negotiating = session(server)
+        set(server, "activeSession", negotiating)
+        refresh(server)
+        assertFalse(Files.exists(root.resolve("active")))
+        val wired = session(server)
+        set(server, "wiredSession", wired)
+        listener(server).onSessionActive(wired)
+        refresh(server)
+        assertFalse(Files.exists(root.resolve("active")))
+    }
+    @Test fun oldCloseCannotEraseNewOwner() = withServer { server, root ->
+        val old = session(server)
+        listener(server).onSessionActive(old); refresh(server)
+        val next = session(server)
+        val nextPhone = "02:00:00:00:00:02"
+        set(server, "selectedPhone", nextPhone)
+        listener(server).onSessionActive(next); refresh(server)
+        old.close()
+        assertEquals(nextPhone, Files.readString(root.resolve("active")))
+        next.close()
+        assertEquals("", Files.readString(root.resolve("active")))
+    }
+    @Test fun closingDuringPublicationLeavesPresenceIdle() = withServer { server, root ->
+        val live = session(server)
+        listener(server).onSessionActive(live)
+        Files.createFile(root.resolve("hold"))
+        val executor = Executors.newFixedThreadPool(2)
+        try {
+            val publishing = executor.submit { refresh(server) }
+            val deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(3)
+            while (!Files.exists(root.resolve("publishing")) && System.nanoTime() < deadline) Thread.sleep(10)
+            assertTrue("helper began publication", Files.exists(root.resolve("publishing")))
+            val ending = executor.submit { live.close() }
+            // The end callback waits for the in-flight publication before clearing it.
+            Files.delete(root.resolve("hold"))
+            publishing.get(8, TimeUnit.SECONDS)
+            ending.get(8, TimeUnit.SECONDS)
+            assertEquals("", Files.readString(root.resolve("active")))
+            assertEquals("idle", Files.readAllLines(root.resolve("commands")).last())
+        } finally {
+            executor.shutdownNow()
+        }
+    }
+}
