+    /** Live-session ownership must not depend on ARP learning; the settings page needs it to disconnect.
+     * Serialize publication and idle clearing so a slow helper cannot resurrect a closed session.
+     * Only an actually active wireless session is reported, never an invitation or negotiation.
+     */
+    private fun refreshWirelessPresence(): Unit = synchronized(presenceStateLock) {
+        val session = connectedSession ?: return
+        val phone = connectedWirelessPhone ?: return
+        if (activeSession !== session || cablePhone) return
+        if (!presenceActive) presenceActive = presence("active", phone)
+        // Continue learning the Wi-Fi identity for normal invitations, independently of active reporting.
+        if (!presenceLearned) presenceLearned = presence("remember", session.host, phone, session.controllerId.orEmpty())
+    }
