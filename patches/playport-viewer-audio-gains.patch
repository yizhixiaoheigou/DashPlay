new file mode 100644
index 0000000..e375718
--- /dev/null
+++ b/web/src/audio-mix.ts
@@ -0,0 +1,47 @@
+/** Volume relative to the level this page has always used, for each sound CarPlay sends.
+ *
+ *  Navigation prompts ("default") already carry a boost when music goes to the car over Bluetooth
+ *  (the ×3 in main.ts, or ?promptgain=): 100 % in this panel means that existing level, not an unboosted one.
+ *  Alerts ("alert"), Siri, calls and media start at ×1. Media is played through a media element whose
+ *  volume stops at 1, so it can only be turned down.
+ */
+export const AUDIO_CATEGORIES = ['default', 'media', 'speechrecognition', 'telephony', 'alert'] as const;
+export type AudioCategory = (typeof AUDIO_CATEGORIES)[number];
+
+/** Keeps this browser's choice across reloads; language and master volume live in their own keys. */
+export const STORAGE_KEY = 'f50-audio-mix';
+
+/** The level in use before this panel existed: ×3 for prompts when music goes over the car's Bluetooth. */
+export function baseGain(name: string, promptBoost: number): number {
+  return name === 'default' ? Math.min(8, Math.max(1, promptBoost)) : 1;
+}
+
+export function maxPercent(name: string): number {
+  return name === 'media' ? 100 : 300;
+}
+
+export function clampPercent(name: string, percent: number): number {
+  return Math.min(maxPercent(name), Math.max(0, Number.isFinite(percent) ? percent : 100));
+}
+
+/** What the audio engine applies: the base times the percentage, capped like the old ?promptgain= (×8). */
+export function effectiveGain(base: number, percent: number): number {
+  return Math.min(8, Math.max(0, base * percent / 100));
+}
+
+/** Read this browser's saved mix; unknown or broken entries fall back to 100 %. */
+export function parseMix(raw: string | null): Partial<Record<AudioCategory, number>> {
+  let data: unknown;
+  try { data = JSON.parse(raw ?? '{}'); } catch { return {}; }
+  if (!data || typeof data !== 'object') return {};
+  const mix: Partial<Record<AudioCategory, number>> = {};
+  for (const category of AUDIO_CATEGORIES) {
+    const value = (data as Record<string, unknown>)[category];
+    if (typeof value === 'number' && Number.isFinite(value)) mix[category] = clampPercent(category, value);
+  }
+  return mix;
+}
+
+export function mixPercent(mix: Partial<Record<AudioCategory, number>>, category: AudioCategory): number {
+  return clampPercent(category, mix[category] ?? 100);
+}
