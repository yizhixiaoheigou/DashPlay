+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import ts from 'typescript';
+
+// The sound-level panel rests on these numbers: 100 % must reproduce today's level, and the caps keep the
+// existing limiter behaviour (×8 for prompts) while media, played through a media element, only turns down.
+const source = readFileSync(new URL('./src/audio-mix.ts', import.meta.url), 'utf8');
+const { outputText } = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } });
+const mix = await import(`data:text/javascript;base64,${Buffer.from(outputText).toString('base64')}`);
+
+assert.deepEqual(mix.AUDIO_CATEGORIES, ['default', 'media', 'speechrecognition', 'telephony', 'alert']);
+assert.equal(mix.baseGain('default', 3), 3, 'navigation keeps its existing ×3 boost as the base');
+assert.equal(mix.baseGain('default', 8), 8);
+assert.equal(mix.baseGain('default', 0), 1, 'the old ?promptgain= floor becomes the base');
+assert.equal(mix.baseGain('media', 3), 1, 'only navigation carries the prompt boost');
+assert.equal(mix.baseGain('speechrecognition', 3), 1);
+assert.equal(mix.maxPercent('media'), 100, 'a media element cannot go above 1');
+assert.equal(mix.maxPercent('telephony'), 300);
+assert.equal(mix.clampPercent('media', 250), 100);
+assert.equal(mix.clampPercent('telephony', -5), 0);
+assert.equal(mix.clampPercent('telephony', Number.NaN), 100);
+assert.equal(mix.effectiveGain(3, 150), 4.5, 'percentage is relative to the base');
+assert.equal(mix.effectiveGain(3, 0), 0);
+assert.equal(mix.effectiveGain(8, 300), 8, 'the existing ×8 ceiling still applies');
+assert.deepEqual(mix.parseMix(null), {});
+assert.deepEqual(mix.parseMix('not json'), {});
+assert.deepEqual(mix.parseMix('{"default":150,"media":250,"unknown":50}'), { default: 150, media: 100 });
+assert.equal(mix.mixPercent({ default: 150 }, 'default'), 150);
+assert.equal(mix.mixPercent({}, 'telephony'), 100, 'unset categories keep today’s level');
+console.log('Sound-level checks passed: base levels, percentage, caps and saved values');
