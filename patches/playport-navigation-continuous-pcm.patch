+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import ts from 'typescript';
+import { setImmediate as settle } from 'node:timers/promises';
+const source = name => readFileSync(new URL(`./src/${name}.ts`, import.meta.url), 'utf8');
+function evaluate(code, scope, name) {
+ const js=ts.transpileModule(code.replace(/^import .*;\n/gm,'').replace(/export /g,''),{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext}}).outputText;
+ return vm.runInNewContext(`${js}\n${name}`,scope);
+}
+const timers=new Map();let serial=0;
+const win={setTimeout:fn=>{timers.set(++serial,fn);return serial;},clearTimeout:id=>timers.delete(id)};
+class Node { gain={value:1}; threshold={value:0};knee={value:0};ratio={value:0};attack={value:0};release={value:0}; connect(out){this.out=out;} disconnect(){this.out=null;} }
+class Context {state='running';sampleRate=48000;currentTime=0;destination=new Node();createGain(){return new Node();}createDynamicsCompressor(){return new Node();}resume(){this.state='running';return Promise.resolve();}suspend(){this.state='suspended';return Promise.resolve();}}
+const scope={window:win,AudioContext:Context,MusicOutput:{supported:()=>false},performance:{now:()=>0},AudioCodec:{Lpcm:3,AacLc:1,Opus:2},pageDropsMusic:(drop,name)=>drop&&name==='media',baseGain:(name,boost)=>name==='default'?boost:1,clampPercent:(_,v)=>v,effectiveGain:(base,v)=>base*v/100,audioStartTime:()=>0};
+scope.PcmResampler=evaluate(source('pcm-resampler'),{},'PcmResampler');
+const Engine=evaluate(source('audio'),scope,'AudioEngine');
+const config=(name='default',streamType=101)=>({kind:'audio-config',name,streamType,codec:3,sampleRate:16000,channels:2,description:new Uint8Array()});
+const failures=[];
+async function test(name,fn){try{await fn();console.log('PASS',name);}catch(e){failures.push(name);console.error('FAIL',name,e.message);}}
+await test('navigation PCM uses native-rate buffers, keeps channels and isolates a new stream',()=>{
+ const buffers=[];Context.prototype.createBuffer=function(channels,length,rate){const planes=[];const b={duration:length/rate,copyToChannel:(p,c)=>planes[c]=p,rate,planes};buffers.push(b);return b;};
+ Context.prototype.createBufferSource=function(){return {connect(){},disconnect(){},start(){}};};
+ const a=new Engine(()=>{});a.unlocked=true;a.handleConfig({...config(),sampleRate:8000});
+ const bytes=new Uint8Array(240);const v=new DataView(bytes.buffer);for(let i=0;i<60;i++){v.setInt16(i*4,8000,true);v.setInt16(i*4+2,-8000,true);}
+ a.handlePacket({streamType:101,data:bytes});assert.equal(buffers[0].rate,48000);assert.ok(buffers[0].planes[0].some(x=>x>0));assert.ok(buffers[0].planes[1].every((x,i)=>Math.abs(x+buffers[0].planes[0][i])<1e-7));
+ a.stopAll();a.handleConfig({...config(),sampleRate:8000});a.handlePacket({streamType:101,data:new Uint8Array(240)});assert.ok(buffers.at(-1).planes.every(p=>p.every(x=>x===0)));
+ a.handleConfig(config('telephony',102));assert.equal(a.streams.get(102).resampler,null,'call path unchanged');
+});
+assert.deepEqual(failures,[],`${failures.length} navigation regression(s)`);
