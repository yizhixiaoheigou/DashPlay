+++ b/web/check-pcm-resampler.mjs
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import ts from 'typescript';
+const source=readFileSync(new URL('./src/pcm-resampler.ts',import.meta.url),'utf8');
+const {outputText}=ts.transpileModule(source,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext}});
+const {PcmResampler}=await import(`data:text/javascript;base64,${Buffer.from(outputText).toString('base64')}`);
+for(const rate of [44100,48000]) {
+ const input=Float32Array.from({length:8000},(_,i)=>.4*Math.sin(2*Math.PI*997*i/8000));
+ const right=input.map(v=>-v);
+ const full=new PcmResampler(8000,rate,2).push([input,right]);
+ for(const sizes of [[60],[1,7,31,60,320,9]]) {
+  const stream=new PcmResampler(8000,rate,2), output=[[],[]];let at=0,n=0;
+  while(at<input.length){const end=Math.min(input.length,at+sizes[n++%sizes.length]);const chunk=stream.push([input.slice(at,end),right.slice(at,end)]);chunk.forEach((p,c)=>output[c].push(...p));at=end;}
+  for(let c=0;c<2;c++)assert.deepEqual(Float32Array.from(output[c]),full[c],`packetization must not change samples at ${rate} Hz`);
+  assert.ok(stream.history[0].length<=32,'history bounded independently of stream duration');
+ }
+ assert.equal(full[0].length,Math.ceil((8000-16)*rate/8000),'only 2 ms lookahead, no 40 ms aggregation');
+ let error=0;
+ for(let i=1000;i<full[0].length-1000;i++)error+=(full[0][i]-.4*Math.sin(2*Math.PI*997*i/rate))**2;
+ assert.ok(Math.sqrt(error/(full[0].length-2000))<.001,'low-rate sine remains clean after continuous upsampling');
+ const silence=new PcmResampler(8000,rate,2).push([new Float32Array(800),new Float32Array(800)]);
+ assert.ok(silence.every(p=>p.every(v=>v===0)),'silence cannot create hiss');
+}
+const fresh=new PcmResampler(8000,48000,1);assert.ok(fresh.push([new Float32Array(60)] )[0].every(v=>v===0),'new stream has no previous samples');
+assert.throws(()=>new PcmResampler(48000,8000,1));
+assert.throws(()=>fresh.push([new Float32Array(2),new Float32Array(2)]));
+console.log('Streaming PCM: packet boundaries, 44.1/48 kHz, stereo, signal accuracy, silence, bounded history and reset passed');
