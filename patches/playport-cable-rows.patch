diff --git a/server/src/test/kotlin/com/playport/server/CableRoleTest.kt b/server/src/test/kotlin/com/playport/server/CableRoleTest.kt
new file mode 100644
index 0000000..f53d5e6
--- /dev/null
+++ b/server/src/test/kotlin/com/playport/server/CableRoleTest.kt
@@ -0,0 +1,101 @@
+package com.playport.server
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.boolean
+import java.nio.file.Files
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The cable's CarPlay is the viewer's choice and has nothing to do with the box's internet (2026-10-31): the
+ * phone list has a row per way in, and switching between rows never needs a network setting. Before, moving the
+ * same phone from the cable to Wi-Fi only worked after changing "car internet" in the settings page.
+ */
+class CableRoleTest {
+    private fun temp() = Files.createTempDirectory("cable").resolve("cable-carplay-off")
+
+    @Test fun withoutAMarkerPathTheCableAlwaysCarriesCarPlay() {
+        val role = CableRole(null, static = false)
+        assertTrue(role.carPlayOnCable())
+        assertFalse(role.turnOff())
+    }
+
+    @Test fun pickingAWirelessRowTurnsTheCableOffUntilTheUnplug() {
+        val file = temp()
+        val role = CableRole(file, static = false).also { it.init() }
+        assertTrue(role.carPlayOnCable())
+        assertTrue(role.turnOff())
+        assertFalse(role.carPlayOnCable())
+        assertEquals(CableRole.ONCE, String(Files.readAllBytes(file)).trim())
+        // Plugging in again is wired by default.
+        role.unplugged()
+        assertTrue(role.carPlayOnCable())
+    }
+
+    @Test fun pickingTheWiredRowTurnsTheCableBackOn() {
+        val role = CableRole(temp(), static = false)
+        role.turnOff()
+        assertTrue(role.turnOn())
+        assertTrue(role.carPlayOnCable())
+    }
+
+    @Test fun wirelessOnlyKeepsTheCableOffAcrossUnplugsAndTheViewerCannotOverrideIt() {
+        val file = temp()
+        val role = CableRole(file, static = true).also { it.init() }
+        assertFalse(role.carPlayOnCable())
+        assertTrue(role.staticOff)
+        role.unplugged()
+        assertFalse(role.carPlayOnCable())
+        assertFalse(role.turnOn())
+        assertFalse(role.carPlayOnCable())
+    }
+
+    @Test fun aStaleWirelessOnlyMarkerGoesWhenTheSettingChanged() {
+        val file = temp()
+        CableRole(file, static = true).init()
+        CableRole(file, static = false).init()
+        assertTrue(CableRole(file, static = false).carPlayOnCable())
+    }
+
+    @Test fun aOneOffChoiceSurvivesAReceiverRestartWhileThePhoneStaysPluggedIn() {
+        val file = temp()
+        CableRole(file, static = false).turnOff()
+        val restarted = CableRole(file, static = false).also { it.init() }
+        assertFalse(restarted.carPlayOnCable())
+    }
+
+    @Test fun theWiredRowFollowsThePlugAndTheCablesRole() {
+        assertNull(CableRole.wiredRow(plugged = false, carPlayOnCable = true, live = false, staticOff = false))
+        assertNull(CableRole.wiredRow(plugged = true, carPlayOnCable = false, live = false, staticOff = true))
+        assertEquals("live", CableRole.wiredRow(plugged = true, carPlayOnCable = true, live = true, staticOff = false))
+        assertEquals("starting", CableRole.wiredRow(plugged = true, carPlayOnCable = true, live = false, staticOff = false))
+        assertEquals("available", CableRole.wiredRow(plugged = true, carPlayOnCable = false, live = false, staticOff = false))
+    }
+
+    @Test fun aLiveCableSessionIsTheOnlyRowInUse() {
+        val raw = """[{"address":"02:00:00:00:00:0A","name":"Phone A","active":true}]"""
+        val body = PhoneList.withWired(PhoneList.body(true, raw), "live", "Phone A")
+        val parsed = Json.parseToJsonElement(body).jsonObject
+        assertEquals("live", parsed["wired"]!!.jsonPrimitive.content)
+        assertEquals("Phone A", parsed["wiredName"]!!.jsonPrimitive.content)
+        val phone = (parsed["phones"] as kotlinx.serialization.json.JsonArray)[0].jsonObject
+        assertFalse(phone["active"]!!.jsonPrimitive.boolean)
+    }
+
+    @Test fun aWirelessSessionStaysInUseBesideAnAvailableCable() {
+        val raw = """[{"address":"02:00:00:00:00:0A","name":"Phone A","active":true}]"""
+        val body = PhoneList.withWired(PhoneList.body(true, raw), "available", "Phone A")
+        val phone = (Json.parseToJsonElement(body).jsonObject["phones"] as kotlinx.serialization.json.JsonArray)[0].jsonObject
+        assertTrue(phone["active"]!!.jsonPrimitive.boolean)
+    }
+
+    @Test fun noRowLeavesTheBodyAlone() {
+        val body = PhoneList.body(true, "[]")
+        assertEquals(body, PhoneList.withWired(body, null, "x"))
+    }
+}
