+package com.playport.server
+
+import java.nio.file.Files
+import java.nio.file.Path
+
+/**
+ * Whether the USB cable carries CarPlay (2026-10-31). Independent of how the box reaches the internet: the iPhone
+ * stays in its CarPlay USB configuration either way, so its USB internet interface works with or without CarPlay
+ * on the cable. The viewer's phone list has one row per way in ("wired · phone", "wireless · phone", ...); picking
+ * a wireless row while CarPlay is on the cable turns the cable's CarPlay off, picking the wired row turns it on.
+ *
+ * The marker file (CARPLAY_CABLE_OFF_FILE) is read by iphone-usb-bridge.py each time it starts: present means
+ * "report the iPhone as tether, stay out of usbmux/NCM". Its content says who wrote it:
+ *  - "once": the viewer picked a wireless row; cleared when the iPhone is unplugged, so the next plug-in is wired.
+ *  - "static": the owner chose wireless only (CARPLAY_CABLE_CARPLAY=off); kept across unplugs.
+ */
+class CableRole(private val file: Path?, private val static: Boolean) {
+    /** At receiver start: a static choice writes the marker; a stale static marker from an earlier setting goes. */
+    fun init() {
+        val path = file ?: return
+        runCatching {
+            if (static) write(STATIC)
+            else if (read() == STATIC) Files.deleteIfExists(path)
+        }
+    }
+
+    /** Whether CarPlay may run on the cable now. Without a marker path the cable always carries CarPlay. */
+    fun carPlayOnCable(): Boolean = file == null || !Files.exists(file)
+
+    /** The owner chose wireless only: the wired row is not offered at all. */
+    val staticOff: Boolean get() = file != null && static
+
+    /** The viewer picked a wireless row: the cable stops carrying CarPlay until the iPhone is unplugged. */
+    fun turnOff(): Boolean {
+        if (file == null) return false
+        return runCatching { if (!Files.exists(file)) write(ONCE); true }.getOrDefault(false)
+    }
+
+    /** The viewer picked the wired row. A static choice is not overridden from the viewer. */
+    fun turnOn(): Boolean {
+        if (file == null || static) return false
+        return runCatching { Files.deleteIfExists(file); true }.getOrDefault(false)
+    }
+
+    /** The iPhone was unplugged: a one-off choice ends with it. */
+    fun unplugged() {
+        if (file == null || static) return
+        runCatching { if (read() == ONCE) Files.deleteIfExists(file) }
+    }
+
+    // readAllBytes, not readString: Android 5 (API 21) has no Files.readString.
+    private fun read(): String? = runCatching { String(Files.readAllBytes(file!!)).trim() }.getOrNull()
+
+    private fun write(value: String) {
+        val path = file ?: return
+        path.parent?.let { Files.createDirectories(it) }
+        val temporary = path.resolveSibling(path.fileName.toString() + ".tmp")
+        Files.write(temporary, (value + "\n").toByteArray())
+        Files.move(temporary, path, java.nio.file.StandardCopyOption.REPLACE_EXISTING)
+    }
+
+    companion object {
+        const val ONCE = "once"
+        const val STATIC = "static"
+
+        fun fromEnvironment(): CableRole = CableRole(
+            System.getenv("CARPLAY_CABLE_OFF_FILE")?.takeIf { it.isNotBlank() }?.let { Path.of(it) },
+            System.getenv("CARPLAY_CABLE_CARPLAY") == "off",
+        )
+
+        /**
+         * The viewer's wired row: "live" (CarPlay on the cable now), "starting" (being brought up), "available"
+         * (plugged in, CarPlay off on the cable, tap to move it there), or null (no row: nothing plugged in, or
+         * wireless only).
+         */
+        fun wiredRow(plugged: Boolean, carPlayOnCable: Boolean, live: Boolean, staticOff: Boolean): String? = when {
+            !plugged || staticOff -> null
+            live -> "live"
+            carPlayOnCable -> "starting"
+            else -> "available"
+        }
+    }
+}
