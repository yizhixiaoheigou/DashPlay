diff --git a/web/src/simple-settings.ts b/web/src/simple-settings.ts
new file mode 100644
--- /dev/null
+++ b/web/src/simple-settings.ts
@@ -0,0 +1,65 @@
+/** The same select values and change handlers, presented as ordinary in-page buttons. */
+export function simpleSettings(panel: HTMLElement, enabled: boolean) {
+  const controls = Array.from(panel.querySelectorAll<HTMLSelectElement>('select')).map(select => {
+    // A button inside a label would also activate the hidden native picker.
+    const label = select.closest('label');
+    if (label) {
+      const row = document.createElement('div');
+      row.className = label.className;
+      row.classList.add('simple-row');
+      row.append(...Array.from(label.childNodes));
+      label.replaceWith(row);
+      const title = row.querySelector<HTMLElement>('b, span');
+      if (title) {
+        title.id ||= `${select.id}-label`;
+        select.setAttribute('aria-labelledby', title.id);
+      }
+    }
+    const group = document.createElement('div');
+    group.className = 'simple-options';
+    group.setAttribute('role', 'group');
+    const title = select.getAttribute('aria-labelledby');
+    if (title) group.setAttribute('aria-labelledby', title);
+    else group.setAttribute('aria-label', select.getAttribute('aria-label') || select.id);
+    select.after(group);
+    let signature = '';
+    const sync = () => {
+      if (select.hidden !== enabled) select.hidden = enabled;
+      group.hidden = !enabled;
+      const disabled = select.matches(':disabled');
+      const next = JSON.stringify([select.value, disabled, Array.from(select.options, o => [o.value, o.text, o.disabled])]);
+      if (next === signature) return;
+      signature = next;
+      // Keep focus on the chosen button when a change handler refreshes the values.
+      const focused = document.activeElement instanceof HTMLButtonElement && group.contains(document.activeElement)
+        ? document.activeElement.dataset.value : undefined;
+      group.replaceChildren(...Array.from(select.options, option => {
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.textContent = option.text;
+        button.dataset.value = option.value;
+        button.disabled = disabled || option.disabled;
+        button.setAttribute('aria-pressed', String(select.value === option.value));
+        button.onclick = () => {
+          if (select.matches(':disabled')) return;
+          select.value = option.value;
+          select.dispatchEvent(new Event('change', { bubbles: true }));
+          sync();
+        };
+        return button;
+      }));
+      if (focused !== undefined) Array.from(group.querySelectorAll('button')).find(b => b.dataset.value === focused)?.focus();
+    };
+    select.addEventListener('change', sync);
+    const observer = new MutationObserver(sync);
+    observer.observe(select, { attributes: true, childList: true, characterData: true, subtree: true });
+    const fieldset = select.closest('fieldset');
+    if (fieldset) observer.observe(fieldset, { attributes: true, attributeFilter: ['disabled'] });
+    return sync;
+  });
+  return {
+    get enabled() { return enabled; },
+    set(value: boolean) { enabled = value; this.sync(); },
+    sync() { for (const sync of controls) sync(); },
+  };
+}
