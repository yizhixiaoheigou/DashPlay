+/** Box settings page (pairing, hotspot): same host, plain HTTP. The port comes from the startup flag, else from
+ *  the access file the receiver writes (the Linux boxes announce no flag, and the link stayed hidden). */
+function showBoxLinks(port: number) {
+  const base = `http://${location.hostname}${port === 80 ? '' : `:${port}`}/`;
+  const links: [string, string][] = [['box-link', base], ['add-phone-panel', `${base}#phones`], ['box-settings-panel', base]];
+  for (const [id, href] of links) {
+    const link = el<HTMLAnchorElement>(id);
+    link.href = href;
+    link.hidden = false;
+  }
 }
+const boxPort = Number((window as unknown as { playportBoxSettingsPort?: number }).playportBoxSettingsPort) || 0;
+if (boxPort) showBoxLinks(boxPort);
+else void fetch('./receiver-access.json', { cache: 'no-store' }).then(r => r.ok ? r.json() : null)
+  .then(access => { const port = Number(access?.settingsPort) || 0; if (port) showBoxLinks(port); })
+  .catch(() => { /* no settings page on this box: the links stay hidden */ });
 function render() {
   setLanguage(language);
   updateFullscreen();
