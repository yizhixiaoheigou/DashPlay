--- /dev/null
+++ b/server/src/main/kotlin/com/playport/server/CableRecovery.kt
@@ -0,0 +1,25 @@
+package com.playport.server
+
+/** A physical unplug is fresh presence evidence for one paired phone, for a bounded time only. */
+internal class CableRecovery {
+    private var phone: String? = null
+    private var until = 0L
+    private var next = 0L
+    private var remaining = 0
+
+    @Synchronized fun begin(target: String?, now: Long) {
+        phone = target
+        until = now + 45_000
+        next = now + 5_000
+        remaining = if (target == null) 0 else 3
+    }
+    @Synchronized fun cancel() { phone = null; remaining = 0 }
+    @Synchronized fun active(target: String?, now: Long): Boolean =
+        phone != null && phone == target && now < until
+    @Synchronized fun take(target: String?, now: Long, running: Boolean): Boolean {
+        if (!active(target, now) || remaining == 0 || now < next || running) return false
+        remaining--
+        next = now + 5_000
+        return true
+    }
+}
