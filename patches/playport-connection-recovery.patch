+package com.playport.server
+
+import java.io.EOFException
+import org.junit.Assert.*
+import org.junit.Test
+
+class WiredRunResourcesTest {
+    @Test fun oldTimeoutCannotCloseNewRunAndRepeatedCloseIsHarmless() {
+        val closed = mutableListOf<String>()
+        val old = WiredRunResources(AutoCloseable { closed.add("old-pipe") })
+        old.add(AutoCloseable { closed.add("old-session") })
+        val next = WiredRunResources(AutoCloseable { closed.add("next-pipe") })
+        old.close()
+        old.close()
+        assertEquals(listOf("old-session", "old-pipe"), closed)
+        assertFalse(next.closed)
+        next.close()
+        assertEquals("next-pipe", closed.last())
+    }
+    @Test fun resourceOpenedDuringCancellationIsClosed() {
+        val run = WiredRunResources(AutoCloseable {})
+        run.close()
+        var closed = false
+        try { run.add(AutoCloseable { closed = true }); fail("Cancelled run accepted resource") }
+        catch (_: EOFException) { assertTrue(closed) }
+    }
+}
