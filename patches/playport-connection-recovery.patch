+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class ConnectionSelectionTest {
+    @get:Rule val temporary = TemporaryFolder()
+    private val phoneA = "02:00:00:00:00:0A"
+    private val phoneB = "02:00:00:00:00:0B"
+    private fun field(server: CarPlayServer, name: String) =
+        CarPlayServer::class.java.getDeclaredField(name).also { it.isAccessible = true }
+    private fun set(server: CarPlayServer, name: String, value: Any?) = field(server, name).set(server, value)
+    private fun listener(server: CarPlayServer) = field(server, "listener").get(server) as AirPlaySessionListener
+    private fun session(server: CarPlayServer) = AirPlaySession(Socket(), server.airPlayConfig,
+        server.identity, PairingStore(), null, listener(server), object : AirPlayMediaHandler {})
+    private fun rows(server: CarPlayServer): JsonObject {
+        val body = PhoneList.body(true, """[{"address":"$phoneA","name":"A","active":false},{"address":"$phoneB","name":"B","active":true}]""")
+        val method = CarPlayServer::class.java.getDeclaredMethod("withWiredRow", String::class.java)
+        method.isAccessible = true
+        return Json.parseToJsonElement(method.invoke(server, body) as String).jsonObject
+    }
+    private fun selected(body: JsonObject) = body["phones"]!!.jsonArray.filter {
+        it.jsonObject["active"]!!.jsonPrimitive.boolean
+    }.map { it.jsonObject["address"]!!.jsonPrimitive.content }
+    private fun run(block: (CarPlayServer) -> Unit) {
+        val root = temporary.newFolder().toPath()
+        CarPlayServer(ServerConfig(identityDir=root, stateDir=root.resolve("state"), bindAddress="127.0.0.1")).use {
+            set(it, "wired", WiredBootstrap(it, Path.of("unused-helper.py")))
+            block(it)
+        }
+    }
+
+    @Test fun liveWirelessOverridesStalePresenceAndSelectionIntent() = run { server ->
+        set(server, "selectedPhone", phoneA)
+        val live = session(server)
+        listener(server).onSessionActive(live)
+        set(server, "selectedPhone", phoneB) // Invitation intent is not the live session owner.
+        assertEquals(listOf(phoneA), selected(rows(server)))
+        live.close()
+        assertTrue(selected(rows(server)).isEmpty())
+    }
+
+    @Test fun availableCableDoesNotHideTheActiveWirelessPhone() = run { server ->
+        val role = CableRole(temporary.newFolder().toPath().resolve("off"), false)
+        role.turnOff()
+        set(server, "cableRole", role)
+        set(server, "cablePresent", true)
+        set(server, "selectedPhone", phoneA)
+        val live = session(server)
+        listener(server).onSessionActive(live)
+        val body = rows(server)
+        assertEquals("available", body["wired"]!!.jsonPrimitive.content)
+        assertEquals(listOf(phoneA), selected(body))
+        live.close()
+    }
+
+    @Test fun negotiationAndDisconnectedStatesDoNotSelectStaleWirelessRows() = run { server ->
+        set(server, "selectedPhone", phoneA)
+        val negotiating = session(server)
+        set(server, "activeSession", negotiating)
+        assertTrue(selected(rows(server)).isEmpty())
+        negotiating.close()
+    }
+
+    @Test fun lateCloseOfOldSessionDoesNotClearNewSelection() = run { server ->
+        set(server, "selectedPhone", phoneA)
+        val old = session(server)
+        listener(server).onSessionActive(old)
+        set(server, "selectedPhone", phoneB)
+        val next = session(server)
+        listener(server).onSessionActive(next)
+        old.close()
+        assertEquals(listOf(phoneB), selected(rows(server)))
+        next.close()
+    }
+
+    @Test fun wiredSessionIsTheOnlySelection() = run { server ->
+        val live = session(server)
+        set(server, "cablePresent", true)
+        set(server, "wiredSession", live)
+        listener(server).onSessionActive(live)
+        val body = rows(server)
+        assertEquals("live", body["wired"]!!.jsonPrimitive.content)
+        assertTrue(selected(body).isEmpty())
+        live.close()
+    }
+
+    @Test fun activeWirelessKeepsItsSessionOnPlug() = run { server ->
+        val role = CableRole(temporary.newFolder().toPath().resolve("off"), false)
+        set(server, "cableRole", role)
+        val live = session(server)
+        listener(server).onSessionActive(live)
+        assertFalse(server.prepareCablePhone())
+        assertFalse(role.carPlayOnCable())
+        live.close()
+    }
+
+    @Test fun unplugClearsCableIdentityEvenAfterUserAlreadySwitchedToWireless() = run { server ->
+        server.rememberCablePhone(phoneA)
+        set(server, "cablePhone", false)
+        server.cableUnplugged()
+        assertNull(field(server, "cableWirelessPhone").get(server))
+    }
+
+    @Test fun unplugUsesAuthenticatedCableTargetAndArmsRecoveryEvenWithoutWifi() {
+        val root = temporary.newFolder().toPath()
+        val helper = root.resolve("presence.py")
+        java.nio.file.Files.writeString(helper, """
+            import sys
+            if sys.argv[1] == 'unplugged':
+                print(sys.argv[2])
+            else:
+                sys.exit(1)
