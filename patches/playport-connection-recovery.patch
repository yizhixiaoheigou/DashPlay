+package com.playport.server
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class CableRecoveryTest {
+    @Test fun failedFirstInviteCanRetryWithoutWifiPresenceButNotForever() {
+        val recovery = CableRecovery()
+        recovery.begin("A", 0)
+        assertFalse(recovery.take("A", 4999, false))
+        assertTrue(recovery.take("A", 5000, false))
+        assertTrue(recovery.take("A", 10000, false))
+        assertTrue(recovery.take("A", 15000, false))
+        assertFalse(recovery.take("A", 20000, false))
+        assertFalse(recovery.active("A", 45000))
+    }
+    @Test fun slowBluetoothHandshakeIsNotInterruptedAndDoesNotConsumeAnAttempt() {
+        val recovery = CableRecovery()
+        recovery.begin("A", 0)
+        assertFalse(recovery.take("A", 5000, true))
+        assertTrue(recovery.take("A", 10000, false))
+    }
+    @Test fun newCableManualChoiceSuccessOrPauseCancelsTheGrant() {
+        val recovery = CableRecovery()
+        recovery.begin("A", 0)
+        assertFalse(recovery.take("B", 5000, false))
+        recovery.cancel()
+        assertFalse(recovery.take("A", 6000, false))
+        recovery.begin(null, 7000)
+        assertFalse(recovery.active(null, 7001))
+    }
+}
