--- /dev/null
+++ b/protocol/src/test/java/com/shilapi/xcertplay/transport/LockdownSharingTest.kt
@@ -0,0 +1,56 @@
+package com.shilapi.xcertplay.transport
+
+import java.nio.ByteBuffer
+import org.junit.Assert.*
+import org.junit.Test
+
+class LockdownSharingTest {
+    private val dummy = byteArrayOf(1) // Synthetic material; TLS is tested separately, never deployed.
+    private val record = LockdownPairRecord.restore("test-host", "test-buid", "02:00:00:00:00:01",
+        dummy, dummy, dummy, dummy, dummy, dummy)
+    private class Stream(body: String) : BlockingDuplexByteStream {
+        private val xml = "<plist version=\"1.0\"><dict>$body</dict></plist>".toByteArray()
+        private val input = ByteBuffer.allocate(xml.size + 4).putInt(xml.size).put(xml).array()
+        private var offset = 0
+        var closed = false
+        val sent = mutableListOf<ByteArray>()
+        override fun send(data: ByteArray) { sent.add(data.copyOf()) }
+        override fun recv(maxBytes: Int, timeoutMillis: Long): ByteArray {
+            val end = minOf(offset + maxBytes, input.size)
+            return input.copyOfRange(offset, end).also { offset = end }
+        }
+        override fun close() { closed = true }
+    }
+    @Test fun sharingStartsTrustWithoutOpeningAnyServiceOrCarPlay() {
+        val stream = Stream("<key>EnableSessionSSL</key><true/>")
+        var tlsCalls = 0
+        val channel = LockdownCarKitClient.startSession(stream, record, "test") { wire, pair ->
+            assertSame(record, pair); tlsCalls++; wire
+        }
+        assertEquals(1, tlsCalls)
+        assertEquals(1, stream.sent.size)
+        val request = String(stream.sent.single().drop(4).toByteArray())
+        assertTrue(request.contains("StartSession"))
+        assertFalse(request.contains("StartService"))
+        assertFalse(request.contains("carkit"))
+        assertFalse(stream.closed)
+        channel.close()
+        assertTrue(stream.closed)
+    }
+    @Test fun invalidPairRecordClosesTheConnectionAndRemainsDistinguishableForRepair() {
+        val stream = Stream("<key>Error</key><string>InvalidHostID</string>")
+        try {
+            LockdownCarKitClient.startSession(stream, record, "test") { _, _ -> error("must not use TLS") }
+            fail("invalid record accepted")
+        } catch (error: IphoneUsbException.Protocol) { assertTrue(error.message!!.contains("InvalidHostID")) }
+        assertTrue(stream.closed)
+    }
+    @Test fun failedTlsHandshakeClosesDetachedTransport() {
+        val stream = Stream("<key>EnableSessionSSL</key><true/>")
+        try {
+            LockdownCarKitClient.startSession(stream, record, "test") { _, _ -> throw IllegalStateException("TLS test failure") }
+            fail("TLS failure ignored")
+        } catch (_: IllegalStateException) { }
+        assertTrue(stream.closed)
+    }
+}
