+        val worker = thread(isDaemon=true) {
+            entered.countDown()
+            if (delay.await(5000)) done.countDown()
+        }
+        assertTrue(entered.await(1, TimeUnit.SECONDS))
+        delay.request()
+        assertTrue(done.await(1, TimeUnit.SECONDS))
+        worker.join(1000)
+    }
+}
