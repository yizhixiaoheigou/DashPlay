+class ViewerPhonePauseTest {
+    @get:Rule val temp = TemporaryFolder()
+    private val phone = "02:00:00:00:00:01"
+    private fun field(s: CarPlayServer, n: String) = CarPlayServer::class.java.getDeclaredField(n).also { it.isAccessible = true }
+    private fun run(fail: Boolean = false, block: (CarPlayServer, AirPlaySession) -> Unit) {
+        val root = temp.newFolder().toPath()
+        val helper = root.resolve("presence.py")
+        Files.writeString(helper, """
+            import sys
+            if sys.argv[1] == 'pause' and ${if (fail) "True" else "False"}: sys.exit(1)
+            print('ok')
+        """.trimIndent())
+        CarPlayServer(ServerConfig(identityDir=root,stateDir=root.resolve("state"),bindAddress="127.0.0.1",wireless=true)).use { s ->
+            field(s,"presenceHelper").set(s,helper.toString())
+            field(s,"selectedPhone").set(s,phone)
+            val listener = field(s,"listener").get(s) as AirPlaySessionListener
+            val session = AirPlaySession(Socket(),s.airPlayConfig,s.identity,PairingStore(),null,listener,object: AirPlayMediaHandler {})
+            listener.onSessionActive(session)
+            block(s,session)
+        }
+    }
+    @Test fun pauseClosesOwnerAndCancelsRecovery() = run { s, _ ->
+        assertNull(s.pausePhone(phone))
+        assertNull(field(s,"activeSession").get(s))
+        assertNull((field(s,"sessionRecovery").get(s) as WirelessSessionRecovery).candidate(System.nanoTime()/1_000_000))
+        assertFalse(field(s,"bootInvite").getBoolean(s))
+        assertEquals(0,field(s,"quickRetriesLeft").getInt(s))
+    }
+    @Test fun failedDurablePauseDoesNotDropTheSession() = run(true) { s, session ->
+        assertEquals("pause-failed",s.pausePhone(phone))
+        assertSame(session,field(s,"activeSession").get(s))
+    }
+    @Test fun stalePhoneAndCableCannotDisconnectCurrentOwner() = run { s, session ->
+        assertEquals("invalid",s.pausePhone("wrong"))
+        assertEquals("not-active",s.pausePhone("02:00:00:00:00:02"))
+        assertSame(session,field(s,"activeSession").get(s))
+        field(s,"cablePhone").setBoolean(s,true)
+        assertEquals("busy",s.pausePhone(phone))
+        assertSame(session,field(s,"activeSession").get(s))
+    }
+}
