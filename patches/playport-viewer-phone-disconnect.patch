+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import ts from 'typescript';
+const main = readFileSync(new URL('./src/main.ts', import.meta.url), 'utf8');
+const source = main.slice(main.indexOf('interface BoxPhone'), main.indexOf('function fit()'));
+const code = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022 } }).outputText;
+class Element {
+  constructor(tag = 'div') { this.tagName = tag; this.children = []; this.hidden = false; this.attributes = {}; }
+  set textContent(value) { this.text = value; this.children = []; }
+  get textContent() { return this.text || ''; }
+  append(...nodes) { this.children.push(...nodes); }
+  setAttribute(key, value) { this.attributes[key] = value; }
+}
+const phone = { address: '02:00:00:00:00:01', name: 'Test iPhone', active: true, last: true };
+function setup() {
+  const nodes = {}, requests = [], timers = [];
+  const context = vm.createContext({
+    el: id => nodes[id] ??= new Element(), document: { createElement: tag => new Element(tag) },
+    t: key => key, token: 'synthetic-token', panel: { open: true }, toast() {},
+    window: { setTimeout: callback => timers.push(callback) },
+    fetch: async (url, init) => {
+      requests.push({ url, init });
+      return { ok: true, json: async () => init?.method === 'POST' ? { ok: true } : { supported: true, phones: [phone] } };
+    },
+  });
+  vm.runInContext(code, context);
+  return { context, nodes, requests, run: text => vm.runInContext(text, context) };
+}
+{
+  const { nodes, requests, run } = setup();
+  await run('loadDevices()');
+  const row = nodes['device-list'].children[0];
+  assert.equal(row.tagName, 'div', 'current phone has a separate action, no nested buttons');
+  const button = row.children.find(e => e.className === 'device-disconnect');
+  assert.equal(button.textContent, 'deviceDisconnect');
+  assert.equal(button.disabled, false);
+  assert.match(button.attributes['aria-label'], /Test iPhone/);
+  await run('disconnectFrom(boxPhones[0])');
+  assert.match(requests.at(-1).url, /\/api\/phones\/disconnect\?token=/);
+  assert.equal(JSON.parse(requests.at(-1).init.body).address, phone.address);
+  const reconnect = nodes['device-list'].children[0];
+  assert.equal(reconnect.tagName, 'button', 'one paired phone can reconnect after pause');
+  assert.equal(reconnect.children.at(-1).textContent, 'deviceConnect');
+  assert.equal(nodes['devices-status'].textContent, 'deviceDisconnected');
+  await run('switchTo(boxPhones[0])');
+  assert.match(requests.at(-1).url, /\/api\/phones\/switch\?token=/);
+}
+{
+  const { context, nodes, run } = setup();
+  await run('loadDevices()');
+  let finish, calls = 0;
+  context.fetch = () => { calls++; return new Promise(resolve => { finish = resolve; }); };
+  const pending = run('disconnectFrom(boxPhones[0])');
+  assert.equal(nodes['device-list'].children[0].children.at(-1).disabled, true);
+  await run('disconnectFrom(boxPhones[0])');
+  await run('switchTo(boxPhones[0])');
+  assert.equal(calls, 1, 'in-flight action prevents duplicate disconnect and switch');
+  finish({ ok: false, json: async () => ({ error: 'pause-failed' }) });
+  await pending;
+  assert.equal(run('boxPhones[0].active'), true, 'failure does not claim disconnection');
+  assert.equal(nodes['devices-status'].textContent, 'deviceDisconnectFail');
+  assert.equal(nodes['device-list'].children[0].children.at(-1).disabled, false);
+}
+{
+  const { context, run } = setup();
+  await run('loadDevices()');
+  let finish;
+  context.fetch = (_url, init) => init?.method === 'POST'
+    ? Promise.resolve({ ok: true, json: async () => ({ ok: true }) })
+    : new Promise(resolve => { finish = resolve; });
+  const stale = run('loadDevices()');
+  await run('disconnectFrom(boxPhones[0])');
+  finish({ ok: true, json: async () => ({ supported: true, phones: [phone] }) });
+  await stale;
+  assert.equal(run('boxPhones[0].active'), false, 'old GET cannot undo completed disconnect');
+}
+console.log('Phone actions: live disconnect, single-phone reconnect, failures, busy guard and stale read passed.');
