new file mode 100644
--- /dev/null
+++ b/server/src/test/kotlin/com/playport/server/PhoneDisconnectApiTest.kt
@@ -0,0 +1,48 @@
+package com.playport.server
+
+import io.ktor.server.engine.embeddedServer
+import io.ktor.server.netty.Netty
+import kotlinx.coroutines.*
+import org.junit.Assert.*
+import org.junit.Test
+import java.net.URI
+import java.net.http.*
+import java.nio.file.Files
+
+class PhoneDisconnectApiTest {
+    @Test fun disconnectRequiresOwnPageAndValidWirelessPhoneAndKeepsSwitchWorking() {
+        val dir = Files.createTempDirectory("phone-disconnect")
+        val scope = CoroutineScope(Dispatchers.Default)
+        val token = "0123456789abcdef0123456789abcdef"
+        val hub = WebHub(ServerConfig(identityDir=dir,stateDir=dir,accessToken=token),DisplayState(640,480,30,100),scope)
+        val calls = mutableListOf<String>()
+        hub.onDisconnectPhone = { calls.add("disconnect:$it"); null }
+        hub.onSwitchPhone = { calls.add("switch:$it"); null }
+        hub.onSwitchCable = { calls.add("cable"); null }
+        val server = embeddedServer(Netty,port=0,host="127.0.0.1") { hub.install(this,dir) }.start(false)
+        try {
+            val port = runBlocking { server.engine.resolvedConnectors().first().port }
+            val origin = "http://127.0.0.1:$port"
+            val client = HttpClient.newHttpClient()
+            val body = """{"address":"02:00:00:00:00:0a"}"""
+            fun request(data: String = body, action: String = "disconnect", credential: String = token, source: String = origin): Int =
+                client.send(HttpRequest.newBuilder(URI("$origin/api/phones/$action?token=$credential"))
+                    .header("Origin",source).header("Content-Type","application/json")
+                    .POST(HttpRequest.BodyPublishers.ofString(data)).build(), HttpResponse.BodyHandlers.ofString()).statusCode()
+            assertEquals(403,request(credential="bad"))
+            assertEquals(403,request(source="https://outside.example"))
+            assertEquals(400,request("not json"))
+            assertEquals(400,request("{}"))
+            assertEquals(400,request("""{"cable":true}"""))
+            assertTrue(calls.isEmpty())
+            assertEquals(200,request())
+            assertEquals(200,request(action="switch"))
+            assertEquals(200,request("""{"cable":true}""",action="switch"))
+            assertEquals(listOf("disconnect:02:00:00:00:00:0A","switch:02:00:00:00:00:0A","cable"),calls)
+            hub.onDisconnectPhone = { "not-active" }
+            assertEquals(409,request())
+            hub.onDisconnectPhone = null
+            assertEquals(409,request())
+        } finally { server.stop(0,1000); scope.cancel(); dir.toFile().deleteRecursively() }
+    }
+}
