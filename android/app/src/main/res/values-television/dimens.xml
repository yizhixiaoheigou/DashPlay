    <dimen name="text_head">26sp</dimen>
    <dimen name="text_body">20sp</dimen>
    <dimen name="text_small">16sp</dimen>
    <dimen name="text_tiny">14sp</dimen>
    <dimen name="button_height">56dp</dimen>
    <dimen name="row_height">56dp</dimen>
    <dimen name="dot">30dp</dimen>
    <dimen name="qr">168dp</dimen>
    <dimen name="focus_stroke">4dp</dimen>
    <dimen name="content_max">900dp</dimen>
</resources>
