    <string name="q_identity_done">身份已导入</string>
    <string name="q_identity_none_tv">这台设备没有文件选择器，可从文件管理器分享身份文件到 DashPlay。</string>
    <string name="q_identity_importing">正在导入……</string>

    <string name="q_car">使用哪种车机？</string>
    <string name="q_car_why">特斯拉需要单独选择访问方式，后续将按车型检查条件。</string>
    <string name="car_tesla">特斯拉</string>
    <string name="car_tesla_sub">使用特斯拉网页适配。还需可访问的网络地址；不会自动修改热点网段。</string>
    <string name="car_other">其他车机</string>
    <string name="car_other_sub">使用浏览器访问接收端，具体能力以车机实际支持为准。</string>

    <string name="q_network">车机通过哪个网络访问接收端？</string>
    <string name="q_network_why">车机浏览器需要与这台安卓设备网络互通；无线连接时，iPhone 也需要接入可互访的网络。</string>
    <string name="network_this">这台设备的热点</string>
    <string name="network_this_sub">车机连接本机热点，无线 iPhone 也连接此热点。本地传输不要求 SIM 卡；车机访问互联网需另有可用网络来源。</string>
    <string name="set_background">后台运行</string>
    <string name="background_unavailable">此设备没有可打开的应用设置页，请在系统设置中查找后台运行或电池策略。</string>
    <string name="set_background_sub">锁屏或切换应用后断开时，在系统应用设置中将电池策略设为不限制，并允许后台运行。</string>
    <string name="network_car">车机自己的热点</string>
    <string name="network_car_sub">安卓加入车机热点，iPhone 通过数据线接入</string>
