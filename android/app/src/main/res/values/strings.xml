    <string name="q_wifi">Wi-Fi 名称和密码</string>
    <string name="q_wifi_wired">无需 Wi-Fi 参数</string>
    <string name="q_wifi_wired_why">当前使用数据线连接 iPhone，无需填写它要加入的 Wi-Fi。已有无线参数会保留；安卓与车机仍需通过热点、Wi-Fi 或网线互通。</string>
    <string name="q_wifi_why_hotspot">填写本机热点的名称和密码。无线连接时，iPhone 会通过蓝牙获得这些信息并尝试接入。</string>
    <string name="q_wifi_why_other">填写外部网络的名称和密码，用于邀请无线 iPhone 接入；不会代替安卓系统连接该网络。</string>
    <string name="q_wifi_from_system">已读取系统热点信息，请核对。</string>
