    <string name="wifi_password_short">密码至少 8 位</string>

    <string name="q_voice">声音通过哪个设备播放？</string>
    <string name="q_voice_why">选择期望的声音出口；特斯拉车型的音乐、通话与 Siri 默认走车机蓝牙。</string>
    <string name="voice_car">通过车机蓝牙或 iPhone 播放</string>
    <string name="voice_car_sub">音乐、导航等由 iPhone 直接连车机蓝牙播放；提示音保留在 CarPlay。</string>
    <string name="voice_page">通过 CarPlay 网页播放</string>
    <string name="voice_page_sub">声音由车机浏览器播放；特斯拉模式下音乐、通话与 Siri 仍走车机蓝牙。</string>

    <string name="q_iphone">iPhone 使用哪种连接方式？</string>
    <string name="q_iphone_why">安卓手机仅支持无线 CarPlay，需填写 Wi-Fi 参数并配对。安卓盒子还可选数据线，随后完成本机授权。</string>
    <string name="iphone_any">自动选择（推荐）</string>
    <string name="iphone_any_sub">没有活动无线会话时插线优先有线；已经连着无线时插线保留无线，可在画面的「盒子设置」里手动切换。</string>
    <string name="iphone_wireless">只用无线</string>
    <string name="iphone_wireless_sub">请先添加 iPhone。数据线不承载 CarPlay；如需通过数据线使用 iPhone 网络，可单独开启该功能。</string>
    <string name="iphone_wireless_ruled_out">当前车机热点方案仅支持数据线 CarPlay，请返回更换网络方案以使用无线连接。</string>
    <string name="iphone_wired">只用数据线</string>
    <string name="iphone_wired_sub">通过 OTG 连接 iPhone，首次使用需允许 USB 与本地 VPN。</string>

