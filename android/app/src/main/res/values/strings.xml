    <string name="step_count">第 %1$d 步，共 %2$d 步</string>
    <string name="q_device">这台设备是什么？</string>
    <string name="q_device_why">安卓手机仅支持无线 CarPlay；安卓电视盒子可按硬件条件使用有线或无线。此项也决定界面布局与启动方式，Root 和热点能力另行检测。</string>
    <string name="device_phone">安卓手机</string>
    <string name="device_phone_sub">仅支持无线 CarPlay，需要蓝牙及可互访的 Wi-Fi；适合触屏手机或平板</string>
    <string name="device_box">安卓电视盒子</string>
    <string name="device_box_sub">支持大屏双列排布与遥控器操作；接 HDMI 初设后可放车上无屏使用</string>
    <string name="summary_device">设备</string>
    <string name="q_identity">导入 CarPlay 身份</string>
