    <!-- Setup: one question a page -->
    <string name="step_count">第 %1$d 步，共 %2$d 步</string>
    <string name="q_device">这台设备是什么？</string>
    <string name="q_device_why">安卓手机和安卓电视盒子都能装 DashPlay；此项只影响屏幕排布与称呼，热点、Root 与数据线能力均按本机实际情况开放。以后可在设置里改。</string>
    <string name="device_phone">安卓手机</string>
    <string name="device_phone_sub">竖屏单列排布，适合触屏手机或平板随身使用</string>
    <string name="device_box">安卓电视盒子</string>
    <string name="device_box_sub">支持大屏双列排布与遥控器操作；接 HDMI 初设后可放车上无屏使用</string>
    <string name="summary_device">设备</string>
    <string name="q_identity">导入 CarPlay 身份</string>
    <string name="q_identity_why">本软件不附带 CarPlay 身份，请自行导入。</string>
    <string name="q_identity_pick">导入身份</string>
    <string name="q_identity_found">在这台设备上找到：</string>
    <string name="q_identity_done">身份已导入</string>
    <string name="q_identity_none_tv">这台设备没有文件选择器，可从文件管理器分享身份文件到 DashPlay。</string>
    <string name="q_identity_importing">正在导入……</string>

    <string name="q_car">什么车？</string>
    <string name="q_car_why">特斯拉要单独处理网址，其他车不用。</string>
    <string name="car_tesla">特斯拉</string>
    <string name="car_tesla_sub">使用特斯拉网页适配。还需可访问的网络地址；不会自动修改热点网段。</string>
    <string name="car_other">其他车</string>
    <string name="car_other_sub">小鹏、比亚迪等，用默认设置</string>

    <string name="q_network">车机连哪个 Wi-Fi？</string>
    <string name="q_network_why">车机和 iPhone 要连到同一个网络，车机才能打开画面。</string>
    <string name="network_this">这台设备的热点（推荐）</string>
    <string name="network_this_sub">不需要 SIM 卡或互联网，车机和 iPhone 都连它。车机若要上网，还需要可用的上网来源。</string>
    <string name="set_background">后台运行</string>
    <string name="background_unavailable">此设备没有可打开的应用设置页，请在系统设置中查找后台运行或电池策略。</string>
    <string name="set_background_sub">锁屏或切换应用后断开时，在系统应用设置中将电池策略设为不限制，并允许后台运行。</string>
    <string name="network_car">车机自己的热点</string>
    <string name="network_car_sub">安卓加入车机热点，iPhone 通过数据线接入</string>
    <string name="network_mifi">外部路由器 / 随身 WiFi</string>
    <string name="network_this_short">这台设备的热点</string>
    <string name="iphone_any_short">都行</string>
    <string name="network_mifi_sub">这台设备通过 Wi-Fi 或网线连接；车机、iPhone 接入同一网络，路由器需允许设备互相访问。</string>

    <string name="q_wifi">Wi-Fi 名称和密码</string>
    <string name="q_wifi_wired">无需 Wi-Fi 参数</string>
    <string name="q_wifi_wired_why">当前使用数据线连接 iPhone，无需填写它要加入的 Wi-Fi。已有无线参数会保留；安卓与车机仍需通过热点、Wi-Fi 或网线互通。</string>
    <string name="q_wifi_why_hotspot">iPhone 靠它连过来。安卓 8 以上 App 读不到系统热点的密码，请照系统设置里的填。</string>
    <string name="q_wifi_why_other">iPhone 靠它连过来，填车机热点或随身 WiFi 的名称和密码。</string>
    <string name="q_wifi_from_system">已从系统热点读到，核对一下</string>
    <string name="wifi_ssid">名称</string>
    <string name="wifi_password">密码</string>
    <string name="wifi_open_settings">打开系统热点设置</string>
    <string name="wifi_ssid_missing">请填写名称</string>
    <string name="wifi_password_short">密码至少 8 位</string>

    <string name="q_voice">声音是否留在 CarPlay？</string>
    <string name="q_voice_why">留在 CarPlay 时保留完整声音能力，也可以在 iPhone 控制中心选择输出；不走 CarPlay 时，所有声音交给 iPhone 选择的设备。</string>
    <string name="voice_car">不走 CarPlay</string>
    <string name="voice_car_sub">所有声音离开 CarPlay；在 iPhone 上选择手机或车机蓝牙。</string>
    <string name="voice_page">留在 CarPlay</string>
    <string name="voice_page_sub">保留完整声音能力；可在 iPhone 控制中心选择输出。</string>

    <string name="q_iphone">iPhone 用数据线还是无线？</string>
    <string name="q_iphone_why">选择连接方式后，无线连接再填写 Wi-Fi 参数，数据线连接可直接继续。</string>
    <string name="iphone_any">都行，能用就行（推荐）</string>
    <string name="iphone_any_sub">插线默认走有线，CarPlay 画面的「盒子设置」里可随时切到无线；拔线后再插回到有线</string>
    <string name="iphone_wireless">只用无线</string>
    <string name="iphone_wireless_sub">需要先添加 iPhone。数据线不做 CarPlay，只充电；开了 USB 借网也照常上网</string>
    <string name="iphone_wireless_ruled_out">车机热点转发画面太慢，这个选择下只能用数据线</string>
    <string name="iphone_wired">只用数据线</string>
    <string name="iphone_wired_sub">通过 OTG 连接 iPhone，首次使用需允许 USB 与本地 VPN。</string>

