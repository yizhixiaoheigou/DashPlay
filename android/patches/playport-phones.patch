@@ -0,0 +1,42 @@
+package com.shilapi.xcertplay.airplay
+
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.concurrent.atomic.AtomicInteger
+import org.junit.Assert.*
+import org.junit.Test
+
+class AirPlaySetupAuthorizationTest {
+    @Test fun rejectedControllerGetsForbiddenAndConnectionClosesBeforeMediaSetup() {
+        val gateCalls = AtomicInteger()
+        ServerSocket(0, 1, InetAddress.getByName("127.0.0.1")).use { listener ->
+            Socket("127.0.0.1", listener.localPort).use { client ->
+                val session = AirPlaySession(
+                    socket = listener.accept(),
+                    config = AirPlayConfig(deviceName = "test", deviceId = "02:00:00:00:00:02",
+                        btMac = "02:00:00:00:00:01", sourceVersion = "1.0",
+                        main = AirPlayDisplayConfig(widthPixels = 800, heightPixels = 480)),
+                    identity = AirPlayIdentity.generate(), pairings = PairingStore(), mfi = null,
+                    listener = object : AirPlaySessionListener {
+                        override fun onSetupAllowed(session: AirPlaySession): Boolean {
+                            gateCalls.incrementAndGet(); return false
+                        }
+                    }, media = object : AirPlayMediaHandler {},
+                )
+                try {
+                    session.start()
+                    client.soTimeout = 3000
+                    client.getOutputStream().write("SETUP / RTSP/1.0\r\nCSeq: 1\r\nContent-Length: 0\r\n\r\n".toByteArray())
+                    client.getOutputStream().flush()
+                    val input = client.getInputStream().bufferedReader()
+                    assertTrue(input.readLine().contains("403"))
+                    while (!input.readLine().isNullOrEmpty()) { }
+                    assertEquals(-1, input.read())
+                    assertEquals(1, gateCalls.get())
+                    assertTrue(session.activeStreams.isEmpty())
+                } finally { session.close() }
+            }
+        }
+    }
+}
