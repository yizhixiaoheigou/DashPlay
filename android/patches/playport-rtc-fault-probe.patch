@@ -0,0 +1,23 @@
+/** Diagnostic probe: close only the server RTC peer; never invoke the browser fallback directly. */
+export class RtcFaultProbe {
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private used = false;
+  constructor(readonly enabled: boolean, private readonly running: () => boolean,
+    private readonly disconnect: () => void, private readonly report: (state: number) => void = () => {}) {}
+  arm(): void {
+    if (!this.enabled) { this.report(0); return; }
+    if (this.used || this.timer !== null) return;
+    this.timer = setTimeout(() => {
+      this.timer = null;
+      if (!this.running()) { this.report(3); return; }
+      this.used = true;
+      this.report(4);
+      this.disconnect();
+    }, 15000);
+    this.report(1);
+  }
+  cancel(): void {
+    if (this.timer !== null) { clearTimeout(this.timer); this.report(2); }
+    this.timer = null;
+  }
+}
