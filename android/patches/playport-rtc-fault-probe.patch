+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import ts from 'typescript';
+const source=readFileSync(new URL('src/rtc-fault-probe.ts',import.meta.url),'utf8');
+const js=ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS}}).outputText;
+let jobs=new Map(),seq=0,stops=0,running=true,states=[];
+const exports={};
+new Function('exports','setTimeout','clearTimeout',js)(exports,(fn,ms)=>{assert.equal(ms,15000);jobs.set(++seq,fn);return seq;},id=>jobs.delete(id));
+const {RtcFaultProbe}=exports;
+const fire=()=>{const callbacks=[...jobs.values()];jobs.clear();for(const f of callbacks)f();};
+new RtcFaultProbe(false,()=>running,()=>stops++,n=>states.push(n)).arm();assert.equal(jobs.size,0);assert.deepEqual(states,[0]);
+const once=new RtcFaultProbe(true,()=>running,()=>stops++,n=>states.push(n));once.arm();once.arm();assert.equal(jobs.size,1);fire();assert.equal(stops,1);once.arm();assert.equal(jobs.size,0);
+const cancelled=new RtcFaultProbe(true,()=>running,()=>stops++,n=>states.push(n));cancelled.arm();cancelled.cancel();fire();assert.equal(stops,1);
+cancelled.arm();assert.equal(jobs.size,1,'a cancelled startup may retry after the new RTC first frame');fire();assert.equal(stops,2);cancelled.arm();assert.equal(jobs.size,0,'actual injection remains once per page');
+const ended=new RtcFaultProbe(true,()=>running,()=>stops++,n=>states.push(n));ended.arm();running=false;fire();assert.equal(stops,2);running=true;ended.arm();fire();assert.equal(stops,3);
+assert.deepEqual(states,[0,1,4,1,2,1,4,1,3,1,4]);
+console.log('RTC fault probe: disabled, one actual injection, cancel/rearm, ended/rearm and state evidence passed.');
