+package com.shilapi.xcertplay.airplay
+
+/** Bounded UDP reordering before decoding; contiguous traffic is delivered without waiting. */
+internal class RtpAudioOrder<T>(
+    private val emit: (T) -> Unit,
+    private val nowNs: () -> Long = System::nanoTime,
+    private val maxWaitNs: Long = 80_000_000L,
+    private val maxPackets: Int = 64,
+) {
+    private data class Pending<T>(val value: T, val arrived: Long, val held: Boolean)
+    private val pending = mutableMapOf<Int, Pending<T>>()
+    private var expected: Int? = null
+    var reordered = 0L; private set
+    var lateDropped = 0L; private set
+    var missing = 0L; private set
+    val queued: Int get() = pending.size
+
+    fun offer(sequence: Int, value: T) {
+        val seq = sequence and 0xffff
+        val next = expected ?: seq.also { expected = it }
+        val delta = (seq - next) and 0xffff
+        if (delta >= 0x8000 || pending.containsKey(seq)) { lateDropped++; return }
+        pending[seq] = Pending(value, nowNs(), delta != 0)
+        flush()
+    }
+
+    /** Also called on socket timeout, so one missing packet cannot hold the end of a prompt forever. */
+    fun flush() {
+        while (pending.isNotEmpty()) {
+            val next = expected ?: return
+            val ready = pending.remove(next)
+            if (ready != null) {
+                expected = (next + 1) and 0xffff
+                if (ready.held) reordered++
+                emit(ready.value)
+                continue
+            }
+            val first = pending.keys.minByOrNull { (it - next) and 0xffff } ?: return
+            val distance = (first - next) and 0xffff
+            val oldest = pending.values.minOf { it.arrived }
+            if (pending.size < maxPackets && distance < maxPackets && nowNs() - oldest < maxWaitNs) return
+            missing += distance.toLong()
+            expected = first
+        }
+    }
+}
