+++ b/server/src/test/kotlin/com/playport/server/PlatformWiredTest.kt
@@ -0,0 +1,33 @@
+package com.playport.server
+
+import java.net.BindException
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.ServerSocket
+import org.junit.Assert.assertThrows
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class PlatformWiredTest {
+    @get:Rule val temp = TemporaryFolder()
+
+    @Test fun stoppingTheUsbListenerReleasesItsPortAndAllowsReconnection() {
+        val address = InetAddress.getByName("127.0.0.1")
+        val port = ServerSocket(0, 1, address).use { it.localPort }
+        val server = CarPlayServer(ServerConfig(bindAddress = "127.0.0.1", airPlayPort = port,
+            identityDir = temp.newFolder("identity").toPath(), stateDir = temp.newFolder("state").toPath(), wireless = false))
+        try {
+            repeat(2) {
+                server.listenWired(address)
+                assertThrows(BindException::class.java) {
+                    ServerSocket().use { it.bind(InetSocketAddress(address, port)) }
+                }
+                server.stopWired()
+                server.stopWired()
+                ServerSocket().use { it.bind(InetSocketAddress(address, port)) }
+            }
+        } finally { server.close() }
+        assertThrows(IllegalStateException::class.java) { server.listenWired(address) }
+    }
+}
