@@ -0,0 +1,17 @@
+package com.playport.server
+
+/**
+ * The RTC channel as the receiver sees it (2026-11-03). Implemented in the Android app; a platform without one leaves
+ * it null, and the viewer hub then answers "unsupported" so the page stays on stills.
+ *
+ * The receiver knows nothing about ICE, DTLS or packetisation: it only routes one page's signalling and hands the
+ * platform the same encoded picture the media bridge already forwards.
+ */
+interface PlatformRtc {
+    /** A page asked for an RTC channel. Report a reason through [report] only when it cannot start; offers use hub.sendRtc. */
+    fun start(clientId: Long, hub: WebHub, report: (String?) -> Unit)
+    /** An answer or a trickle candidate from that page; empty strings are not sent. */
+    fun message(clientId: Long, sdp: String?, candidate: String?, mid: String?)
+    /** That page's link closed or was replaced: release only what belongs to it. */
+    fun closed(clientId: Long)
+}
