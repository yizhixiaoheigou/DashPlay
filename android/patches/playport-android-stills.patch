diff --git a/server/src/test/kotlin/com/playport/server/CompatEntryApiTest.kt b/server/src/test/kotlin/com/playport/server/CompatEntryApiTest.kt
new file mode 100644
index 0000000..797b0cd
--- /dev/null
+++ b/server/src/test/kotlin/com/playport/server/CompatEntryApiTest.kt
@@ -0,0 +1,88 @@
+package com.playport.server
+
+import io.ktor.server.engine.embeddedServer
+import io.ktor.server.netty.Netty
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.nio.file.Files
+
+/**
+ * The compatibility entry as a real server, not a unit of it (2026-11-03).
+ *
+ * What this proves without a device:
+ *  - `viewerOnly` installs the viewer surface and nothing else: the page, `/api/status`, `/api/display` and `/ws`
+ *    answer, while the paired-phone list and switch — management, in the receiver's own terms — are absent;
+ *  - an unknown API or `/manage` path answers 404 instead of quietly rendering the viewer page;
+ *  - the still-image frame (`Wire.image`) round-trips its epoch, sequence, size and age, so a page can drop stale
+ *    pictures.
+ *
+ * What it cannot prove: that a real client reaches the address (TeslaAddressProbe measures that), or that a browser
+ * decodes the JPEG (the web suite checks the page side).
+ */
+class CompatEntryApiTest {
+    @Test
+    fun `viewer only installs the viewer surface and no management route`() {
+        val dir = Files.createTempDirectory("compat-entry")
+        Files.writeString(dir.resolve("index.html"), "<!doctype html><title>viewer</title>")
+        val scope = CoroutineScope(Dispatchers.Default)
+        val token = "0123456789abcdef0123456789abcdef"
+        val hub = WebHub(ServerConfig(identityDir = dir, stateDir = dir, accessToken = token), DisplayState(640, 480, 30, 100), scope)
+        hub.onPhones = { """{"supported":true,"phones":[]}""" }
+        val running = embeddedServer(Netty, port = 0, host = "127.0.0.1") {
+            hub.install(this, dir, viewerOnly = true)
+        }.start(false)
+        try {
+            val port = runBlocking { running.engine.resolvedConnectors().first().port }
+            val client = HttpClient.newHttpClient()
+            fun get(path: String, withToken: Boolean = false): Int {
+                val url = "http://127.0.0.1:$port$path" + if (withToken) "?token=$token" else ""
+                return client.send(HttpRequest.newBuilder(URI(url)).GET().build(), HttpResponse.BodyHandlers.ofString()).statusCode()
+            }
+            assertEquals("the page itself", 200, get("/"))
+            assertEquals("viewer status", 200, get("/api/status"))
+            assertEquals("display state a viewer reads", 200, get("/api/display"))
+            assertEquals("paired phones are management: absent here", 404, get("/api/phones", withToken = true))
+            assertEquals("phone switching is management: absent here", 404,
+                client.send(HttpRequest.newBuilder(URI("http://127.0.0.1:$port/api/phones/switch?token=$token"))
+                    .header("Content-Type", "application/json")
+                    .POST(HttpRequest.BodyPublishers.ofString("""{"address":""}""")).build(),
+                    HttpResponse.BodyHandlers.ofString()).statusCode())
+            assertEquals("audio routes are management: absent here", 404, get("/api/audio-routes", withToken = true))
+            assertEquals("/manage never exists on this entry", 404, get("/manage"))
+        } finally { running.stop(0, 1000); scope.cancel(); dir.toFile().deleteRecursively() }
+    }
+
+    @Test
+    fun `a still frame carries the session identity a page needs to drop stale pictures`() {
+        val jpeg = byteArrayOf(0xFF.toByte(), 0xD8.toByte(), 1, 2, 3, 0xFF.toByte(), 0xD9.toByte())
+        val frame = Wire.image(epoch = 7, sequence = 42, width = 1280, height = 720, ageMs = 55, jpeg = jpeg)
+        assertEquals(Wire.IMAGE, frame[0])
+        assertEquals("type + epoch + sequence + width + height + age", 15, Wire.IMAGE_HEADER_BYTES)
+        val view = ByteBuffer.wrap(frame).order(ByteOrder.LITTLE_ENDIAN)
+        assertEquals(7, view.getInt(1))
+        assertEquals(42, view.getInt(5))
+        assertEquals(1280, view.getShort(9).toInt() and 0xffff)
+        assertEquals(720, view.getShort(11).toInt() and 0xffff)
+        assertEquals(55, view.getShort(13).toInt() and 0xffff)
+        assertArrayEquals(jpeg, frame.copyOfRange(Wire.IMAGE_HEADER_BYTES, frame.size))
+    }
+
+    @Test
+    fun `an extreme size is clamped instead of writing a corrupt frame`() {
+        val frame = Wire.image(0, 0, width = 100_000, height = -1, ageMs = 70_000, jpeg = ByteArray(1))
+        val view = ByteBuffer.wrap(frame).order(ByteOrder.LITTLE_ENDIAN)
+        assertEquals(65535, view.getShort(9).toInt() and 0xffff)
+        assertEquals(0, view.getShort(11).toInt() and 0xffff)
+        assertEquals(65535, view.getShort(13).toInt() and 0xffff)
+    }
+}
