+/**
+ * Lossless ISO-BMFF framing for the wired iPhone's 16-bit LPCM music: each block becomes a FLAC frame
+ * with VERBATIM subframes (the samples as they are, no compression), so the browser's media element
+ * (MSE, "fLaC" in MP4) plays it like stream 102's AAC: buffered, no Web Audio stitching, and eligible
+ * for the head unit's media controls.
+ */
+const join = (...parts: Uint8Array[]) => { const b=new Uint8Array(parts.reduce((n,p)=>n+p.length,0));let i=0;for(const p of parts){b.set(p,i);i+=p.length;}return b; };
+const text = (s:string) => new TextEncoder().encode(s);
+const u32 = (...values:number[]) => { const b=new Uint8Array(values.length*4);const v=new DataView(b.buffer);values.forEach((x,i)=>v.setUint32(i*4,x));return b; };
+const u16 = (...values:number[]) => { const b=new Uint8Array(values.length*2);const v=new DataView(b.buffer);values.forEach((x,i)=>v.setUint16(i*2,x));return b; };
+const zeros = (n:number) => new Uint8Array(n);
+const box = (type:string,...parts:Uint8Array[]) => { const data=join(...parts);return join(u32(data.length+8),text(type),data); };
+const full = (type:string,flags:number,...parts:Uint8Array[]) => box(type,u32(flags),...parts);
+const matrix = u32(0x10000,0,0,0,0x10000,0,0,0,0x40000000);
+
+export const FLAC_MIME = 'audio/mp4; codecs="flac"';
+/** Samples per FLAC frame / MP4 fragment: ~85 ms at 48 kHz, 11-12 of the iPhone's 352-sample packets. */
+export const FLAC_BLOCK = 4096;
+
+const RATE_CODES: Record<number,number> = { 88200:1, 176400:2, 192000:3, 8000:4, 16000:5, 22050:6, 24000:7, 32000:8, 44100:9, 48000:10, 96000:11 };
+
+function crc8(data:Uint8Array):number { let c=0;for(const byte of data){c^=byte;for(let i=0;i<8;i++)c=c&0x80?((c<<1)^0x07)&0xff:(c<<1)&0xff;}return c; }
+function crc16(data:Uint8Array):number { let c=0;for(const byte of data){c^=byte<<8;for(let i=0;i<8;i++)c=c&0x8000?((c<<1)^0x8005)&0xffff:(c<<1)&0xffff;}return c; }
+
+/** FLAC's UTF-8-like coding of the frame number (fixed block size stream). */
+function codedNumber(n:number):number[] {
+  if(n<0x80)return [n];
+  const tail:number[]=[];let k=0;
+  do { tail.unshift(0x80|(n&0x3f));n=Math.floor(n/64);k++; } while(n>=(1<<(6-k)));
+  return [((0xff<<(7-k))&0xff)|n,...tail];
