@@ -0,0 +1,38 @@
+package com.playport.server
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** The viewer's "已连接设备" list: only well-formed paired addresses reach the page, with BlueZ names. */
+class PhoneListTest {
+    @Test fun aMalformedHelperAnswerNeverReachesThePage() {
+        assertEquals(emptyList<PhoneEntry>(), PhoneList.parse(null))
+        assertEquals(emptyList<PhoneEntry>(), PhoneList.parse("not json"))
+        assertEquals(emptyList<PhoneEntry>(), PhoneList.parse("""[{"address":"nope","name":"X"}]"""))
+    }
+
+    @Test fun addressesAreNormalisedDeduplicatedAndLimited() {
+        val raw = """[
+            {"address":"02:00:00:00:00:0b","name":"Bob iPhone","active":true,"last":false},
+            {"address":"02:00:00:00:00:0b","name":"duplicate"},
+            {"address":"02:00:00:00:00:0a","name":"","last":true}
+        ]"""
+        assertEquals(listOf("02:00:00:00:00:0B", "02:00:00:00:00:0A"), PhoneList.parse(raw).map { it.address })
+        assertEquals("Bob iPhone", PhoneList.parse(raw)[0].name)
+        // An empty alias falls back to the address, so the page always has something to show.
+        assertEquals("02:00:00:00:00:0A", PhoneList.parse(raw)[1].name)
+    }
+
+    @Test fun aBoxWithoutThePresenceHelperReportsNoDevices() {
+        val body = PhoneList.body(supported = false, raw = null)
+        assertTrue(body.contains("\"supported\":false"))
+        assertTrue(body.contains("\"phones\":[]"))
+    }
+
+    @Test fun theAddressIsWhatTheSwitchUses() {
+        assertTrue(PhoneList.ADDRESS.matches(PhoneList.normalize(" 02:00:00:00:00:0a ")))
+        assertFalse(PhoneList.ADDRESS.matches("02:00:00:00:00"))
+    }
+}
