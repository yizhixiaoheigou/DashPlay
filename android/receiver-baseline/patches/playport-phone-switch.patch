+++ b/server/src/test/kotlin/com/playport/server/PhoneSwitchTest.kt
@@ -0,0 +1,28 @@
+package com.playport.server
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** The viewer's switch is the one place that may replace the phone using CarPlay; otherwise no preemption. */
+class PhoneSwitchTest {
+    private val a = "02:00:00:00:00:0A"
+    private val b = "02:00:00:00:00:0B"
+
+    @Test fun thePreviousPhoneMayNotTakeCarPlayBackDuringASwitch() {
+        assertFalse(CarPlayServer.mayReplaceSession(a, b, b, handoff = false))
+        assertFalse(CarPlayServer.mayReplaceSession(a, b, b, handoff = true))
+    }
+
+    @Test fun theChosenPhoneOrItsUnidentifiedHandoffMayReplaceTheSession() {
+        assertTrue(CarPlayServer.mayReplaceSession(b, b, b, handoff = false))
+        assertTrue(CarPlayServer.mayReplaceSession(null, b, b, handoff = true))
+        assertFalse(CarPlayServer.mayReplaceSession(null, b, b, handoff = false))
+    }
+
+    @Test fun withoutASwitchOnlyTheCurrentOwnersReconnectReplacesItsStaleSession() {
+        assertTrue(CarPlayServer.mayReplaceSession(a, a, null, handoff = false))
+        assertFalse(CarPlayServer.mayReplaceSession(b, a, null, handoff = false))
+        assertFalse(CarPlayServer.mayReplaceSession(null, a, null, handoff = true))
+    }
+}
