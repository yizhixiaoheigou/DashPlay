+/** Viewer connections share the radio with the car's other downloads. AF41 lets supporting Wi-Fi stacks map them
+ *  to WMM video priority; it does not guarantee priority on every driver or AP. Applies to HTTP and HTTPS alike.
+ *  Inspired by the N1/Tesla community fork's IP_TOS change (2026-10-26 review). */
+internal fun configureViewerSocket(bootstrap: ServerBootstrap) {
+    // Keep the existing send-buffer bound: otherwise kernel queues can hide seconds of old picture from LagGate.
+    bootstrap.childOption(ChannelOption.SO_SNDBUF, 128 * 1024)
+    bootstrap.childOption(ChannelOption.IP_TOS, 0x88)   // DSCP AF41 (34), ECN unchanged
+}
