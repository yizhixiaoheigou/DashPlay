             val sent = session.showViewArea(request.area)
             log.info("view area {} ({}x{}) of {}x{} sent={} ({})", request.area, areas[request.area].width,
@@ -710,4 +710,5 @@
         if (request.defer && session != null) {
             display.defer(request.copy(areas = areas))
