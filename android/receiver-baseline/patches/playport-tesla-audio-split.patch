+/** Tesla mode (2026-11-01): music, Siri and calls always go over the Tesla's Bluetooth; the owner only chooses
+ *  whether navigation (and the alerts that come with it) plays on this page. Elsewhere one switch moves every sound. */
+export function categoryDestination(category: keyof typeof CATEGORY_ROUTE, routes: AudioRoutes, tesla: boolean): Destination {
+  if (tesla && (category === 'media' || category === 'speechrecognition' || category === 'telephony')) return 'bluetooth';
+  return routes[CATEGORY_ROUTE[category]];
+}
+/** A moving Tesla answers a page that plays music (a media element) with "video is audio-only while driving"; the
+ *  banner resizes the page, which renegotiated CarPlay every ~10 s (2026-11-01). Music the iPhone still sends here in
+ *  Tesla mode is dropped: it belongs on the Tesla's Bluetooth. */
+export function pageDropsMusic(tesla: boolean, name: string): boolean {
+  return tesla && name === 'media';
+}
 export function sameRoutes(a: AudioRoutes, b: AudioRoutes): boolean {
   return ROUTE_NAMES.every(name => a[name] === b[name]);
 }
