+// Optional real-browser regression; all signals are synthetic, no microphone or device access.
+const profile=await mkdtemp(join(tmpdir(),'dashplay-pcm-'));
+const executable=process.env.CHROME_BIN || (process.platform==='darwin'?'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome':'google-chrome');
+const child=spawn(executable,['--headless','--no-first-run','--no-default-browser-check','--remote-debugging-port=0',`--user-data-dir=${profile}`],{stdio:'ignore'});
+let spawnError;child.on('error',e=>{spawnError=e;});
+let socket;const pending=new Map();let id=0;
+try {
+ let port;for(let i=0;i<100;i++){if(spawnError)throw spawnError;try{port=(await readFile(`${profile}/DevToolsActivePort`,'utf8')).split('\n')[0];break;}catch{await new Promise(r=>setTimeout(r,50));}}
+ if(!port)throw Error('Chrome did not start');
+ const meta=await (await fetch(`http://127.0.0.1:${port}/json/version`)).json();socket=new WebSocket(meta.webSocketDebuggerUrl);
+ await new Promise((resolve,reject)=>{socket.onopen=resolve;socket.onerror=reject;});
+ socket.onmessage=e=>{const m=JSON.parse(e.data);if(m.id){const p=pending.get(m.id);pending.delete(m.id);m.error?p.reject(m.error):p.resolve(m.result);}};
+ const call=(method,params={},sessionId)=>new Promise((resolve,reject)=>{const n=++id;pending.set(n,{resolve,reject});socket.send(JSON.stringify({id:n,method,params,sessionId}));});
+ const {targetId}=await call('Target.createTarget',{url:'about:blank'});const {sessionId}=await call('Target.attachToTarget',{targetId,flatten:true});
+ const html=await readFile(new URL('check-pcm-render.html',import.meta.url),'utf8');
+ const require=createRequire(new URL('package.json',import.meta.url));const ts=require('typescript');
+ const pcm=await readFile(new URL('src/pcm-resampler.ts',import.meta.url),'utf8');
+ const prefix=ts.transpileModule(pcm.replace('export class','class'),{compilerOptions:{target:ts.ScriptTarget.ES2022}}).outputText;
+ const script=prefix+html.match(/<script>([\s\S]*)<\/script>/)[1].replace("document.getElementById('result').textContent=JSON.stringify(", 'return JSON.stringify(').replace(/\.catch[\s\S]*$/,';');
+ const result=await call('Runtime.evaluate',{expression:script,awaitPromise:true,returnByValue:true,timeout:15000},sessionId);
+ if(result.exceptionDetails)throw Error(JSON.stringify(result.exceptionDetails));
+ console.log(result.result.value);
+}finally{socket?.close();if(child.pid && child.exitCode===null){const exited=once(child,'exit');child.kill();await exited;}await rm(profile,{recursive:true,force:true,maxRetries:10,retryDelay:100});}
