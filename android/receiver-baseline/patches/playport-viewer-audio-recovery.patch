@@ -0,0 +1,22 @@
+<!doctype html><meta charset="utf-8"><pre id="result">pending</pre><script>
+(async()=>{
+const rate=8000, output=48000, count=8000;
+const samples=Float32Array.from({length:count},(_,i)=>0.4*Math.sin(2*Math.PI*997*i/rate));
+async function render(size, continuous=false) {
+ const ctx=new OfflineAudioContext(1,count*output/rate,output);
+ const resampler=continuous?new PcmResampler(rate,output,1):null;let written=0;
+ for(let i=0;i<count;i+=size){
+  let data=samples.slice(i,Math.min(count,i+size));
+  if(resampler)data=resampler.push([data])[0];if(!data.length)continue;
+  const b=ctx.createBuffer(1,data.length,resampler?output:rate);b.copyToChannel(data,0);
+  const s=ctx.createBufferSource();s.buffer=b;s.connect(ctx.destination);s.start(resampler?written/output:i/rate);written+=data.length;
+ }
+ return (await ctx.startRendering()).getChannelData(0);
+}
+const whole=await render(count), small=await render(60), combined=await render(320),fixed=await render(60,true),fixedWhole=await render(count,true);
+function error(data,reference=whole){let sq=0,max=0;for(let i=200;i<data.length-200;i++){const d=data[i]-reference[i];sq+=d*d;max=Math.max(max,Math.abs(d));}return {rms:Math.sqrt(sq/(data.length-400)),max};}
+if(error(fixed,fixedWhole).max>1e-6)throw Error('Continuous PCM changed across packet boundaries');
+if(error(small).max<0.1)throw Error('Probe did not reproduce original boundary distortion');
+document.getElementById('result').textContent=JSON.stringify({input:'synthetic 997 Hz sine, 8 kHz',packet60:error(small),packet320:error(combined),continuous:error(fixed),continuousPacketBoundary:error(fixed,fixedWhole)});
+})().catch(e=>document.getElementById('result').textContent=String(e));
+</script>
