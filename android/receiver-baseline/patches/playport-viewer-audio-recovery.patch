new file mode 100644
--- /dev/null
+++ b/web/src/pcm-resampler.ts
@@ -0,0 +1,61 @@
+/** Streaming upsampling for low-rate navigation PCM. Each browser AudioBufferSource resamples in isolation;
+ * preserving history here avoids inserting filter edges every 7.5 ms. Output uses the context's native rate.
+ * The 32-tap windowed-sinc filter needs 16 source frames of lookahead (2 ms at 8 kHz), not a media buffer.
+ * Deliberately only an upsampler: other audio paths keep their existing decoder and timing. */
+export class PcmResampler {
+  private readonly radius = 16;
+  private readonly phases = 1024;
+  private readonly kernels: Float32Array[];
+  private history: Float32Array[];
+  private offset = 0;
+  private received = 0;
+  private produced = 0;
+
+  constructor(private readonly inputRate: number, private readonly outputRate: number, private readonly channels: number) {
+    if (!Number.isFinite(inputRate) || !Number.isFinite(outputRate) || inputRate <= 0 || outputRate < inputRate ||
+        !Number.isInteger(channels) || channels < 1 || channels > 8) throw new Error('Invalid PCM resampler format');
+    this.history = Array.from({ length: channels }, () => new Float32Array());
+    this.kernels = Array.from({ length: this.phases + 1 }, (_, phase) => {
+      const fraction = phase / this.phases;
+      const weights = new Float32Array(this.radius * 2);
+      let sum = 0;
+      for (let tap = 0; tap < weights.length; tap++) {
+        const distance = tap - this.radius + 1 - fraction;
+        const sinc = Math.abs(distance) < 1e-9 ? 1 : Math.sin(Math.PI * distance) / (Math.PI * distance);
+        const window = 0.5 + 0.5 * Math.cos(Math.PI * distance / this.radius);
+        weights[tap] = sinc * window; sum += weights[tap];
+      }
+      for (let tap = 0; tap < weights.length; tap++) weights[tap] /= sum;
+      return weights;
+    });
+  }
+
+  push(planes: Float32Array[]): Float32Array<ArrayBuffer>[] {
+    if (planes.length !== this.channels || planes.some(p => p.length !== planes[0].length)) throw new Error('Invalid PCM planes');
+    this.history = this.history.map((old, channel) => {
+      const joined = new Float32Array(old.length + planes[channel].length);
+      joined.set(old); joined.set(planes[channel], old.length); return joined;
+    });
+    this.received += planes[0].length;
+    // Absolute integer counters avoid packet-dependent rounding and long-session clock drift.
+    const end = Math.max(this.produced, Math.ceil((this.received - this.radius) * this.outputRate / this.inputRate));
+    const output = Array.from({ length: this.channels }, () => new Float32Array(end - this.produced));
+    for (let frame = this.produced; frame < end; frame++) {
+      const position = frame * this.inputRate / this.outputRate, index = Math.floor(position);
+      const kernel = this.kernels[Math.round((position - index) * this.phases)];
+      for (let channel = 0; channel < this.channels; channel++) {
+        let value = 0;
+        for (let tap = 0; tap < kernel.length; tap++) {
+          const sample = index - this.radius + 1 + tap - this.offset;
+          if (sample >= 0 && sample < this.history[channel].length) value += this.history[channel][sample] * kernel[tap];
+        }
+        output[channel][frame - this.produced] = value;
+      }
+    }
+    this.produced = end;
+    const keep = Math.max(0, Math.floor(end * this.inputRate / this.outputRate) - this.radius + 1);
+    const discard = Math.max(0, keep - this.offset);
+    this.history = this.history.map(p => p.slice(discard)); this.offset += discard;
+    return output;
+  }
+}
