+
+/* Settings sheet: slides in from the right edge and leaves the same way. */
+dialog { margin:0 0 0 auto; height:100%; max-height:100%; width:min(480px,100vw); max-width:100%; padding:0; border:0;
+  background:#000; color:inherit; overflow:auto; overscroll-behavior:contain; }
+dialog[open] { animation:sheet-in .32s cubic-bezier(.2,.8,.2,1); }
