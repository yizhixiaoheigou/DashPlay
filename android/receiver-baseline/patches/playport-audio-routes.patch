@@ -0,0 +1,19 @@
+export const ROUTE_NAMES = ['media', 'navigation', 'alert', 'siri', 'calls'] as const;
+export type RouteName = typeof ROUTE_NAMES[number];
+export type Destination = 'carplay' | 'bluetooth';
+export type AudioRoutes = Record<RouteName, Destination>;
+export const CATEGORY_ROUTE = { default: 'navigation', media: 'media', alert: 'alert', speechrecognition: 'siri', telephony: 'calls' } as const;
+export function validRoutes(value: unknown): value is AudioRoutes {
+  return !!value && typeof value === 'object' && ROUTE_NAMES.every(name =>
+    ['carplay', 'bluetooth'].includes((value as AudioRoutes)[name]));
+}
+export function initialRoutes(value: unknown, music: boolean, voice: boolean): AudioRoutes {
+  return validRoutes(value) ? { ...value } : { media: music ? 'bluetooth' : 'carplay', navigation: 'carplay', alert: 'carplay', siri: voice ? 'bluetooth' : 'carplay', calls: voice ? 'bluetooth' : 'carplay' };
+}
+export function sameRoutes(a: AudioRoutes, b: AudioRoutes): boolean {
+  return ROUTE_NAMES.every(name => a[name] === b[name]);
+}
+// Bluetooth's 100% is only a disabled display. Never write it into saved browser gain.
+export function displayedVolume(destination: Destination, savedPercent: number): number {
+  return destination === 'bluetooth' ? 100 : savedPercent;
+}
