@@ -0,0 +1,50 @@
+package com.playport.server
+
+import io.ktor.server.engine.embeddedServer
+import io.ktor.server.netty.Netty
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.nio.file.Files
+
+class AudioRoutesApiTest {
+    @Test fun onlyAuthenticatedOwnPageCanReadAndChangeKnownRoutes() {
+        val dir = Files.createTempDirectory("audio-routes")
+        val scope = CoroutineScope(Dispatchers.Default)
+        val token = "0123456789abcdef0123456789abcdef"
+        val hub = WebHub(ServerConfig(identityDir=dir,stateDir=dir,accessToken=token),DisplayState(640,480,30,100),scope)
+        val changes = mutableListOf<Pair<String?,String?>>()
+        hub.onAudioRoutes = { category, destination ->
+            changes.add(category to destination)
+            """{"supported":true,"routes":{"media":"bluetooth","navigation":"carplay","alert":"carplay","siri":"carplay","calls":"carplay"}}"""
+        }
+        val server = embeddedServer(Netty,port=0,host="127.0.0.1") { hub.install(this,dir) }.start(false)
+        try {
+            val port = runBlocking { server.engine.resolvedConnectors().first().port }
+            val client = HttpClient.newHttpClient()
+            fun request(body: String? = null, credential: String = token, origin: String = "http://127.0.0.1:$port"): Int {
+                val builder = HttpRequest.newBuilder(URI("http://127.0.0.1:$port/api/audio-routes?token=$credential")).header("Origin",origin)
+                if (body != null) builder.header("Content-Type","application/json").POST(HttpRequest.BodyPublishers.ofString(body))
+                return client.send(builder.build(),HttpResponse.BodyHandlers.ofString()).statusCode()
+            }
+            assertEquals(403,request(credential="bad"))
+            assertEquals(403,request(origin="https://outside.example"))
+            assertEquals(403,request("""{"category":"media","destination":"bluetooth"}""",origin="https://outside.example"))
+            assertEquals(400,request("""{"category":"unknown","destination":"bluetooth"}"""))
+            assertEquals(400,request("""{"category":"media","destination":"unknown"}"""))
+            assertTrue(changes.isEmpty())
+            assertEquals(200,request())
+            assertEquals(200,request("""{"category":"media","destination":"bluetooth"}"""))
+            assertEquals(listOf(null to null,"media" to "bluetooth"),changes)
+            hub.onAudioRoutes = { _, _ -> null }
+            assertEquals(409,request("""{"category":"media","destination":"bluetooth"}"""))
+        } finally { server.stop(0,1000); scope.cancel(); dir.toFile().deleteRecursively() }
+    }
+}
