+package com.shilapi.xcertplay.airplay
+
+/** Destinations requested by the owner; actual iPhone route selection still needs device validation. */
+object AudioRoutes {
+    val names = setOf("media", "navigation", "alert", "siri", "calls")
+    val destinations = setOf("carplay", "bluetooth")
+    fun valid(routes: Map<String, String>) = routes.keys == names && routes.values.all { it in destinations }
+    fun parse(text: String): Map<String, String> {
+        val pairs = text.split(',').map { it.split('=') }
+        require(pairs.size == names.size && pairs.all { it.size == 2 }) { "Invalid audio routes" }
+        return pairs.associate { it[0] to it[1] }.also { require(valid(it)) { "Invalid audio routes" } }
+    }
+    fun category(type: Int, name: String?): String? = when {
+        type == 102 -> "media"
+        type == 101 -> "navigation"
+        else -> when (name) {
+            "media" -> "media"
+            "default" -> "navigation"
+            "alert" -> "alert"
+            "telephony" -> "calls"
+            "speechRecognition" -> "siri"
+            else -> null // Main compatibility format remains available for session negotiation.
+        }
+    }
+    fun allows(routes: Map<String, String>, type: Int, name: String?): Boolean =
+        routes[category(type, name)] != "bluetooth"
+}
