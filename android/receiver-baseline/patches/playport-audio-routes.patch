@@ -0,0 +1,45 @@
+package com.shilapi.xcertplay.airplay
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class AudioRoutesTest {
+    private val base = AirPlayConfig(deviceName = "test", deviceId = "02:00:00:00:00:02",
+        btMac = "02:00:00:00:00:02", sourceVersion = "366.0",
+        main = AirPlayDisplayConfig(widthPixels = 1280, heightPixels = 720), microphone = true)
+
+    @Test fun eachChoiceChangesOnlyItsDeclaredAudioCategory() {
+        val original = AirPlayInfoPlist.build(base)["audioFormats"] as List<*>
+        for (name in AudioRoutes.names) {
+            val routes = AudioRoutes.names.associateWith { if (it == name) "bluetooth" else "carplay" }
+            val actual = AirPlayInfoPlist.build(base.copy(audioRoutes = routes))["audioFormats"] as List<*>
+            val expected = original.filter {
+                val f = it as Map<*, *>
+                AudioRoutes.category((f["type"] as Number).toInt(), f["audioType"] as? String) != name
+            }
+            assertEquals(name, expected, actual)
+        }
+    }
+    @Test fun allThirtyTwoCombinationsHaveConsistentFormatsAndLatencies() {
+        val names = AudioRoutes.names.toList()
+        for (mask in 0..31) {
+            val routes = names.mapIndexed { i, n -> n to if (mask and (1 shl i) != 0) "bluetooth" else "carplay" }.toMap()
+            val info = AirPlayInfoPlist.build(base.copy(audioRoutes = routes))
+            if (mask == 31) {
+                assertFalse(info.containsKey("audioFormats"))
+                assertFalse(info.containsKey("audioLatencies"))
+                assertNotEquals(AirPlayInfoPlist.build(base)["features"], info["features"])
+            } else for (key in listOf("audioFormats", "audioLatencies")) {
+                for (entry in info[key] as List<*>) {
+                    val f = entry as Map<*, *>
+                    assertTrue(AudioRoutes.allows(routes, (f["type"] as Number).toInt(), f["audioType"] as? String))
+                }
+            }
+        }
+    }
+    @Test fun routeParserRejectsIncompleteDuplicateOrUnknownChoices() {
+        for (text in listOf("media=bluetooth", "media=carplay,media=bluetooth", "media=bad,navigation=carplay,alert=carplay,siri=carplay,calls=carplay")) {
+            assertThrows(IllegalArgumentException::class.java) { AudioRoutes.parse(text) }
+        }
+    }
+}
