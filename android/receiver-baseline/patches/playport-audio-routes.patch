+    private fun audioRoutesJson(category: String?, destination: String?): String? {
+        val helper = System.getenv("CARPLAY_AUDIO_ROUTES_HELPER") ?: return null
+        return runCatching {
+            val args = if (category == null) listOf("get") else listOf("set", category, destination.orEmpty())
+            val process = ProcessBuilder(listOf("/usr/bin/python3", helper) + args)
+                .redirectError(ProcessBuilder.Redirect.DISCARD).start()
+            if (!process.waitFor(12, java.util.concurrent.TimeUnit.SECONDS)) {
+                process.destroyForcibly()
+                return@runCatching null
+            }
+            if (process.exitValue() == 0) process.inputStream.bufferedReader().readText().take(4096) else null
+        }.getOrNull()
+    }
+
