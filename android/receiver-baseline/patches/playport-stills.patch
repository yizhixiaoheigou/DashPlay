diff --git a/web/check-image.mjs b/web/check-image.mjs
new file mode 100644
index 0000000..31ae22a
--- /dev/null
+++ b/web/check-image.mjs
@@ -0,0 +1,35 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import ts from 'typescript';
+
+// The still-image frame as the server writes it (Wire.kt) and as this page reads it. A one-byte disagreement here
+// shows a shifted or empty JPEG in the car and nothing in any log, so the layout is pinned on both sides.
+const source = readFileSync(new URL('./src/protocol.ts', import.meta.url), 'utf8');
+const { outputText } = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } });
+const { parseWireMessage, WireType } = await import(`data:text/javascript;base64,${Buffer.from(outputText).toString('base64')}`);
+
+const jpeg = new Uint8Array([0xff, 0xd8, 1, 2, 3, 0xff, 0xd9]);
+// [7][epoch u32][sequence u32][width u16][height u16][age u16][jpeg] — 15-byte head, little endian.
+const frame = new Uint8Array(15 + jpeg.length);
+const view = new DataView(frame.buffer);
+frame[0] = WireType.Image;
+view.setUint32(1, 7, true);
+view.setUint32(5, 42, true);
+view.setUint16(9, 1280, true);
+view.setUint16(11, 720, true);
+view.setUint16(13, 55, true);
+frame.set(jpeg, 15);
+
+const message = parseWireMessage(frame.buffer);
+assert.ok(message, 'a still frame parses');
+assert.equal(message.kind, 'image');
+assert.equal(message.epoch, 7);
+assert.equal(message.sequence, 42);
+assert.equal(message.width, 1280);
+assert.equal(message.height, 720);
+assert.equal(message.ageMs, 55);
+assert.deepEqual(Array.from(message.data), Array.from(jpeg), 'the JPEG payload starts after the 15-byte head');
+
+assert.equal(parseWireMessage(new Uint8Array(14).fill(0).buffer), null, 'a truncated head is not a frame');
+
+console.log('Still-image frame check passed: 15-byte head, little-endian fields, JPEG payload boundary.');
diff --git a/web/check-rtc.mjs b/web/check-rtc.mjs
new file mode 100644
index 0000000..7ba3d83
--- /dev/null
+++ b/web/check-rtc.mjs
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import ts from 'typescript';
+
+// The RTC viewer channel, driven with a stub RTCPeerConnection: the rules that matter are which evidence counts and
+// what happens when it fails. A real peer needs two devices and a codec; those are recorded separately on hardware.
+const source = readFileSync(new URL('./src/rtc.ts', import.meta.url), 'utf8');
+const { outputText } = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } });
+
+const sent = [];
+const events = [];
+
+class StubPeer {
+  constructor(config) { this.config = config; this.connectionState = 'new'; StubPeer.last = this; }
+  addTransceiver() {}
+  async setRemoteDescription(description) { this.remote = description; }
+  async createAnswer() { return { type: 'answer', sdp: 'v=0 answer' }; }
+  async setLocalDescription(description) { this.local = description; }
+  async addIceCandidate(candidate) { (this.candidates ??= []).push(candidate); }
+  close() { this.connectionState = 'closed'; }
+}
+globalThis.RTCPeerConnection = StubPeer;
+globalThis.MediaStream = class { constructor(tracks) { this.tracks = tracks; } };
+
+const video = { autoplay: false, muted: false, playsInline: false, srcObject: null, videoWidth: 0, videoHeight: 0, play: async () => {} };
+globalThis.HTMLVideoElement = class {};
+
+const { RtcPlayer } = await import(`data:text/javascript;base64,${Buffer.from(outputText).toString('base64')}`);
+
+// 1. No API in the browser: the channel reports it at once instead of hanging.
+const saved = globalThis.RTCPeerConnection;
+delete globalThis.RTCPeerConnection;
+const missing = new RtcPlayer((m) => { sent.push(m); return true; }, {
+  onConnected: () => events.push('connected'),
+  onFirstFrame: () => events.push('frame'),
+  onFailed: (reason) => events.push(`failed:${reason}`),
+}, video);
+missing.start();
+assert.deepEqual(events, ['failed:unsupported']);
+globalThis.RTCPeerConnection = saved;
+
+// 2. A channel starts only after the page asks for it, with a receive-only video transceiver and no ice servers.
+events.length = 0;
+const player = new RtcPlayer((message) => { sent.push(message); return true; }, {
+  onConnected: () => events.push('connected'),
+  onFirstFrame: (w, h) => events.push(`frame:${w}x${h}`),
+  onFailed: (reason) => events.push(`failed:${reason}`),
+}, video);
+player.start();
+assert.deepEqual(sent.at(-1), { type: 'rtc-start' });
+assert.deepEqual(StubPeer.last.config, { iceServers: [] }, 'local ICE only: no public STUN/TURN');
+
+// 3. The server's offer is answered with the browser's SDP; candidates are passed to the peer.
+await player.onOffer('v=0 offer');
+assert.equal(StubPeer.last.remote.type, 'offer');
+assert.deepEqual(sent.at(-1), { type: 'rtc', sdp: 'v=0 answer' });
+player.onCandidate('candidate:1 1 udp 1 192.168.43.1 5000 typ host', 'video');
+assert.equal(StubPeer.last.candidates.length, 1);
+
+// 4. ICE connecting is not a picture: no frame is reported until the element has real pixels.
+StubPeer.last.connectionState = 'connected';
+StubPeer.last.onconnectionstatechange();
+assert.deepEqual(events, ['connected']);
+assert.equal(player.paintCheck(), false, 'no pixels, no first frame');
+assert.equal(player.running, false);
+
+// 5. Real pixels are the only evidence that makes RTC the running transport.
+video.videoWidth = 1280;
+video.videoHeight = 720;
+assert.equal(player.paintCheck(), true);
+assert.deepEqual(events.at(-1), 'frame:1280x720');
+assert.equal(player.running, true);
+player.paintCheck();
+assert.equal(events.filter((e) => e.startsWith('frame')).length, 1, 'the first frame is reported once');
+
+// 6. A dropped connection reports a failure, and a fallback stops reporting from the old peer.
+StubPeer.last.connectionState = 'failed';
+StubPeer.last.onconnectionstatechange();
+assert.deepEqual(events.at(-1), 'failed:failed');
+player.close(true);
+assert.equal(video.srcObject, null);
+
+const after = events.length;
+StubPeer.last.connectionState = 'failed';
+StubPeer.last.onconnectionstatechange?.();
+assert.equal(events.length, after, 'a closed peer cannot report again');
+
+console.log('RTC viewer check passed: offer/answer, local ICE, first-frame evidence only, failure and close.');
+
+// 7. The owner's JPEG-only choice must keep RTC from starting at all on the compatibility entry.
+const mainSource = readFileSync(new URL('./src/main.ts', import.meta.url), 'utf8');
+assert.match(mainSource, /const jpegOnly = transportChoice === 'JPEG'/, 'the transport choice is read');
+assert.match(mainSource, /compatEntry && !jpegOnly && !rtcGaveUp/, 'JPEG-only skips RTC rather than trying and failing');
+console.log('Transport choice check passed: JPEG-only never starts RTC; absent keeps AUTO.');
diff --git a/web/check-stills.mjs b/web/check-stills.mjs
new file mode 100644
index 0000000..4f11dcf
--- /dev/null
+++ b/web/check-stills.mjs
@@ -0,0 +1,96 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import ts from 'typescript';
+
+// The still-image fallback, exercised with just the DOM surface it uses: no browser, no box.
+const source = readFileSync(new URL('./src/stills.ts', import.meta.url), 'utf8');
+const { outputText } = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } });
+
+const revoked = [];
+const created = [];
+globalThis.URL = {
+  createObjectURL: (blob) => { const url = `blob:${created.length}`; created.push(blob); return url; },
+  revokeObjectURL: (url) => { revoked.push(url); },
+};
+
+// Timers never run: the stall check is asserted by calling the handler directly instead.
+globalThis.window = { setTimeout: () => 1, clearTimeout: () => {} };
+
+const paints = [];
+const errors = [];
+const context = { drawImage: () => {} };
+const canvas = { width: 0, height: 0, getContext: () => context };
+let natural = { width: 320, height: 180 };
+globalThis.performance = { now: () => nowMs };
+let nowMs = 1000;
+
+// An Image whose load completes on demand, so ordering can be controlled exactly.
+const pendingImages = [];
+class Image {
+  constructor() { this.complete = false; this.src = ''; pendingImages.push(this); }
+  get naturalWidth() { return this.complete ? natural.width : 0; }
+  get naturalHeight() { return this.complete ? natural.height : 0; }
+  set src(value) { this._src = value; }
+  get src() { return this._src; }
+  finish() { this.complete = true; this.onload?.(); this.onload = null; }
+}
+globalThis.Image = Image;
+
+const { StillPlayer } = await import(`data:text/javascript;base64,${Buffer.from(outputText).toString('base64')}`);
+
+const player = new StillPlayer(canvas, {
+  onPaint: (first) => paints.push(first),
+  onError: (message) => errors.push(message),
+});
+
+const still = (epoch, sequence, width = 320, height = 180) => ({
+  epoch, sequence, width, height, ageMs: 5, data: new Uint8Array([1, 2, 3]),
+});
+
+// 1. A first still paints, sizes the canvas and reports "first".
+player.push(still(1, 1));
+pendingImages.at(-1).finish();
+assert.deepEqual(paints, [true], 'the first still of a session paints and says so');
+assert.equal(canvas.width, 320);
+assert.equal(canvas.height, 180);
+assert.equal(revoked.length, 1, 'the object URL of a painted still is released');
+assert.equal(player.lastAgeMs, 5);
+
+// 2. An old still that overtook a newer one must not be shown.
+player.push(still(1, 3));
+pendingImages.at(-1).finish();
+const before = paints.length;
+player.push(still(1, 2));
+assert.equal(pendingImages.length, 2, 'the stale still never creates an image');
+assert.equal(paints.length, before, 'a stale still does not paint');
+
+// 3. A still from a previous session (lower epoch) is dropped outright.
+player.push(still(0, 99));
+assert.equal(pendingImages.length, 2, 'an old session never reaches the canvas');
+
+// 4. A new epoch replaces the picture and reports "first" again.
+player.push(still(2, 1));
+pendingImages.at(-1).finish();
+assert.equal(paints.at(-1), true, 'a new session reports a first picture again');
+
+// 5. Only the newest still is kept: a newer one replaces the one still loading, and the replaced URL is released.
+const released = revoked.length;
+player.push(still(2, 2));
+player.push(still(2, 3));
+assert.equal(revoked.length, released + 1, 'the replaced still releases its object URL');
+assert.equal(pendingImages.length, 5, 'the replaced still creates no image of its own beyond its own load');
+
+// 6. A broken image reports an error, not a silent black screen.
+const beforeErrors = errors.length;
+player.push(still(2, 4));
+pendingImages.at(-1).onerror?.();
+assert.equal(errors.length, beforeErrors + 1);
+assert.match(errors.at(-1), /图片/);
+
+// 7. close() drops a waiting still and releases it.
+player.push(still(2, 5));
+const marking = revoked.length;
+player.close();
+assert.equal(revoked.length, marking + 1, 'closing the player releases the waiting still');
+
+console.log('Still-image fallback check passed: epoch and sequence ordering, single-flight painting, error and close.');
