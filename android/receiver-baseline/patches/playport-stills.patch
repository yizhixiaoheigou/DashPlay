diff --git a/web/src/rtc.ts b/web/src/rtc.ts
new file mode 100644
index 0000000..3370ba9
--- /dev/null
+++ b/web/src/rtc.ts
@@ -0,0 +1,113 @@
+/**
+ * The RTC picture channel: the viewer side of the server's `rtc` signalling.
+ *
+ * The box sends an offer and trickle candidates over the control WebSocket; the browser answers with a standard
+ * RTCPeerConnection. Receiving video needs no camera/microphone permission — `getUserMedia` is never called — so the
+ * only capability this needs is RTCPeerConnection itself.
+ *
+ * What the page must not claim: "connected" is not "showing a picture". ICE can connect with a codec this browser
+ * cannot decode, or with no frames at all, so [onFirstFrame] is the only evidence that counts; until then AUTO keeps
+ * the stills on screen and the box's first-frame budget decides when to give up.
+ */
+
+export interface RtcHandlers {
+  /** The channel negotiated and ICE connected (still no picture). */
+  onConnected: () => void;
+  /** A real decoded frame was painted: only now is RTC the running transport. */
+  onFirstFrame: (width: number, height: number) => void;
+  /** The channel ended or failed; `reason` is shown and the page falls back. */
+  onFailed: (reason: string) => void;
+}
+
+export class RtcPlayer {
+  private peer: RTCPeerConnection | null = null;
+  private firstFrame = false;
+  private closed = false;
+
+  constructor(
+    private readonly send: (message: Record<string, unknown>) => boolean,
+    private readonly handlers: RtcHandlers,
+    private readonly video: HTMLVideoElement,
+  ) {
+    this.video.autoplay = true;
+    this.video.muted = true;
+    this.video.playsInline = true;
+  }
+
+  /** Whether this browser can even try; a missing API is an immediate, honest fallback. */
+  static supported(): boolean {
+    return typeof RTCPeerConnection !== 'undefined';
+  }
+
+  start(): void {
+    if (!RtcPlayer.supported()) { this.handlers.onFailed('unsupported'); return; }
+    this.close(false);
+    this.closed = false;
+    this.firstFrame = false;
+    const peer = new RTCPeerConnection({ iceServers: [] });   // local ICE only: the page and the box share a LAN
+    this.peer = peer;
+    peer.addTransceiver('video', { direction: 'recvonly' });
+    peer.onicecandidate = (event) => {
+      if (!event.candidate) return;
+      this.send({ type: 'rtc', candidate: event.candidate.candidate, mid: event.candidate.sdpMid ?? 'video' });
+    };
+    peer.onconnectionstatechange = () => {
+      const state = peer.connectionState;
+      if (state === 'connected') this.handlers.onConnected();
+      else if (state === 'failed' || state === 'disconnected' || state === 'closed') {
+        if (!this.closed) this.handlers.onFailed(state);
+      }
+    };
+    peer.ontrack = (event) => {
+      this.video.srcObject = event.streams[0] ?? new MediaStream([event.track]);
+      void this.video.play().catch(() => { /* autoplay may need the next tap; the stills stay meanwhile */ });
+    };
+    this.send({ type: 'rtc-start' });
+  }
+
+  /** The server's offer. */
+  async onOffer(sdp: string): Promise<void> {
+    const peer = this.peer;
+    if (!peer || this.closed) return;
+    try {
+      await peer.setRemoteDescription({ type: 'offer', sdp });
+      const answer = await peer.createAnswer();
+      await peer.setLocalDescription(answer);
+      this.send({ type: 'rtc', sdp: answer.sdp ?? '' });
+    } catch {
+      this.handlers.onFailed('negotiation');
+    }
+  }
+
+  onCandidate(candidate: string, mid: string): void {
+    const peer = this.peer;
+    if (!peer || this.closed || !candidate) return;
+    void peer.addIceCandidate({ candidate, sdpMid: mid }).catch(() => { /* a late candidate after fallback is noise */ });
+  }
+
+  /** True once the element paints real pixels: evidence from the decoder, not from ICE. */
+  paintCheck(): boolean {
+    if (this.closed) return false;
+    if (this.firstFrame) return true;
+    if (this.video.videoWidth <= 0 || this.video.videoHeight <= 0) return false;
+    this.firstFrame = true;
+    this.handlers.onFirstFrame(this.video.videoWidth, this.video.videoHeight);
+    return true;
+  }
+
+  get running(): boolean { return this.firstFrame; }
+
+  /** Stops the channel. `clear` also empties the element (a fallback keeps other transports untouched). */
+  close(clear: boolean): void {
+    this.closed = true;
+    const peer = this.peer;
+    this.peer = null;
+    if (peer) {
+      peer.onicecandidate = null;
+      peer.ontrack = null;
+      peer.onconnectionstatechange = null;
+      try { peer.close(); } catch { /* already gone */ }
+    }
+    if (clear) { this.video.srcObject = null; this.firstFrame = false; }
+  }
+}
diff --git a/web/src/stills.ts b/web/src/stills.ts
new file mode 100644
index 0000000..547ae40
--- /dev/null
+++ b/web/src/stills.ts
@@ -0,0 +1,141 @@
+/**
+ * The fallback picture: JPEG stills over the control WebSocket (Wire type 7).
+ *
+ * Why it exists: WebCodecs — how this page has always decoded CarPlay — needs a secure context, and a Tesla's browser
+ * offers none over plain HTTP. A car on that entry can still be reached, but only with a picture the box already coded.
+ *
+ * Rules that keep it honest:
+ *  - A still from another session (epoch) replaces the picture outright; an older sequence never overwrites a newer one.
+ *  - Only one image is in flight at a time and a newer still replaces the one waiting, so a slow device shows the
+ *    newest picture rather than a queue of old ones.
+ *  - Images are drawn to the same canvas the decoder uses: touch mapping, display size and layout never change.
+ */
+
+export interface StillMessage {
+  epoch: number;
+  sequence: number;
+  width: number;
+  height: number;
+  ageMs: number;
+  data: Uint8Array;
+}
+
+export interface StillHandlers {
+  /** A still was painted; `first` is true for the first picture of this stream epoch. */
+  onPaint: (first: boolean) => void;
+  onError: (message: string) => void;
+}
+
+/** How long a still may go missing before the page says the fallback stalled. */
+const STALL_MS = 4000;
+
+export class StillPlayer {
+  private epoch = -1;
+  private sequence = -1;
+  private painting = false;
+  private lastPaintAt = 0;
+  private stallTimer = 0;
+  private pending: { url: string; image: HTMLImageElement; width: number; height: number; first: boolean } | null = null;
+  private frames = 0;
+  private bytes = 0;
+  private windowStart = 0;
+  /** Still rate measured over the last window, for the page's statistics line. */
+  fps = 0;
+  lastAgeMs = 0;
+
+  constructor(
+    private readonly canvas: HTMLCanvasElement,
+    private readonly handlers: StillHandlers,
+    private readonly onResolution: (width: number, height: number) => void = () => {},
+  ) {}
+
+  /** A new CarPlay session started: the next still replaces the picture without waiting for a sequence reset. */
+  reset(): void {
+    this.epoch = -1;
+    this.sequence = -1;
+  }
+
+  close(): void {
+    window.clearTimeout(this.stallTimer);
+    this.stallTimer = 0;
+    this.release();
+    this.frames = 0;
+    this.bytes = 0;
+    this.windowStart = 0;
+    this.fps = 0;
+  }
+
+  push(message: StillMessage): void {
+    // Numbers only: an old still that overtook a newer one, or a session that already ended, is dropped.
+    if (message.epoch < this.epoch) return;
+    if (message.epoch === this.epoch && message.sequence <= this.sequence) return;
+    const first = message.epoch !== this.epoch;
+    this.epoch = message.epoch;
+    this.sequence = message.sequence;
+    this.lastAgeMs = message.ageMs;
+    this.armStall();
+    const bytes = new Uint8Array(message.data);   // a plain copy: BlobPart will not take a possibly shared buffer
+    const url = URL.createObjectURL(new Blob([bytes], { type: 'image/jpeg' }));
+    const image = new Image();
+    // A newer picture replaces the one still loading: its object URL is released here, not when it paints.
+    if (this.pending) URL.revokeObjectURL(this.pending.url);
+    this.pending = { url, image, width: message.width, height: message.height, first };
+    image.onload = () => { this.paintNext(); };
+    image.onerror = () => {
+      URL.revokeObjectURL(url);
+      if (this.pending?.image === image) this.pending = null;
+      this.painting = false;
+      this.handlers.onError('图片画面解码失败。');
+    };
+    image.src = url;
+    this.paintNext();
+  }
+
+  private paintNext(): void {
+    if (this.painting) return;
+    const entry = this.pending;
+    if (!entry || !entry.image.complete || entry.image.naturalWidth === 0) return;
+    this.painting = true;
+    this.pending = null;
+    try {
+      if (this.canvas.width !== entry.width || this.canvas.height !== entry.height) {
+        this.canvas.width = entry.width;
+        this.canvas.height = entry.height;
+        this.onResolution(entry.width, entry.height);
+      }
+      this.canvas.getContext('2d')?.drawImage(entry.image, 0, 0, this.canvas.width, this.canvas.height);
+      this.lastPaintAt = performance.now();
+      if (!this.windowStart) this.windowStart = this.lastPaintAt;
+      this.frames++;
+      this.bytes += entry.image.naturalWidth * entry.image.naturalHeight;
+      const elapsed = this.lastPaintAt - this.windowStart;
+      if (elapsed >= 2000) {
+        this.fps = (this.frames * 1000) / elapsed;
+        this.frames = 0;
+        this.windowStart = this.lastPaintAt;
+      }
+      this.pending = null;
+      this.handlers.onPaint(entry.first);
+      URL.revokeObjectURL(entry.url);
+    } finally {
+      this.painting = false;
+      // A newer still may have arrived while this one painted.
+      if (this.pending) window.setTimeout(() => this.paintNext(), 0);
+    }
+  }
+
+  private release(): void {
+    if (this.pending) { URL.revokeObjectURL(this.pending.url); this.pending = null; }
+  }
+
+  private armStall(): void {
+    window.clearTimeout(this.stallTimer);
+    this.stallTimer = window.setTimeout(() => {
+      const since = performance.now() - this.lastPaintAt;
+      if (this.lastPaintAt && since > STALL_MS) this.handlers.onError('图片画面已停止更新，正在重连。');
+    }, STALL_MS);
+  }
+
+  /** Bytes of JPEG received since the last call, for the box's statistics line. */
+  takeBytes(): number { const value = this.bytes; this.bytes = 0; return value; }
+}
