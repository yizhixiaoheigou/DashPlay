+body { margin:0; overflow:hidden; }
+button, input, select { font:inherit; }
+button, select, input[type=number] { color:inherit; background:#30353d; border:1px solid var(--line); border-radius:10px; min-height:48px; padding:10px 16px; }
+button { cursor:pointer; touch-action:manipulation; }
+button:hover { background:#414955; } button:disabled { opacity:.45; cursor:default; }
+:focus-visible { outline:3px solid #91b8ff; outline-offset:3px; }
+[hidden] { display:none !important; }
+#app { width:100vw; height:100vh; height:100dvh; position:relative; background:#000; }
+#screen-container { position:absolute; inset:0; display:flex; justify-content:center; align-items:center; }
+#surface { flex:none; }
+#screen { display:block; width:100%; height:100%; touch-action:none; user-select:none; -webkit-user-select:none; }
+#overlay { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:28px; text-align:center; background:#000; pointer-events:none; }
+h1 { font-size:clamp(30px,5vw,56px); margin:0 0 18px; font-weight:600; letter-spacing:-.025em; }
+#connection-text { font-size:22px; margin:8px 0; } #connection-hint { max-width:36em; color:#b9c0cb; line-height:1.65; }
+#btn-settings { position:absolute; top:max(12px,env(safe-area-inset-top)); right:max(12px,env(safe-area-inset-right)); min-width:48px; padding:10px 12px; background:#252b33d9; border-color:#5a616b; display:flex; align-items:center; gap:8px; }
+#btn-settings span[aria-hidden] { font-size:24px; line-height:1; }
+#app[data-live=true] #btn-settings { display:none; }
+#audio-unlock { position:absolute; bottom:max(16px,env(safe-area-inset-bottom)); left:50%; transform:translateX(-50%); background:#2256a4; white-space:nowrap; }
+#error-banner { position:absolute; bottom:12px; left:12px; right:12px; max-width:650px; margin:auto; padding:14px; background:#542a28; border-radius:12px; max-height:40vh; overflow:auto; }
+#error-text { overflow-wrap:anywhere; } #error-banner button { float:right; }
+dialog { margin:0 0 0 auto; height:100%; max-height:100%; width:min(560px,100vw); max-width:100%; border:0; padding:0; background:var(--panel); color:inherit; }
+dialog::backdrop { background:#0009; }
+header { position:sticky; top:0; z-index:1; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 24px; background:var(--panel); border-bottom:1px solid var(--line); }
+h2 { font-size:25px; margin:0; } h3 { font-size:19px; margin:0; }
+.settings-body { padding:8px 24px 24px; }
+.row,.section-title { display:flex; align-items:center; justify-content:space-between; gap:16px; margin:16px 0; }
+.volume { display:grid; grid-template-columns:1fr auto; gap:12px; margin:24px 0 8px; } input[type=range] { width:100%; grid-column:1/-1; min-height:40px; accent-color:var(--blue); }
+section,details { border-top:1px solid var(--line); padding:18px 0; }
