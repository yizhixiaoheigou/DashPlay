diff --git a/server/src/test/kotlin/com/playport/server/NowPlayingTest.kt b/server/src/test/kotlin/com/playport/server/NowPlayingTest.kt
new file mode 100644
index 0000000..eaa6bf9
--- /dev/null
+++ b/server/src/test/kotlin/com/playport/server/NowPlayingTest.kt
@@ -0,0 +1,29 @@
+package com.playport.server
+import com.shilapi.xcertplay.iap2.message.Iap2Messages
+import org.junit.Assert.*
+import org.junit.Test
+class NowPlayingTest {
+    @Test fun durationPositionAndArtworkArePartialAndBoundToTrack() {
+        val state = NowPlayingState()
+        state.accept(Iap2Messages.buildRaw(0x5001) { group(0) { u64(0,1); u32(4,200000); u8(26,128) }; group(1) { u32(1,50000) } })
+        assertEquals(200000L,state.value.durationMs)
+        assertEquals(50000L,state.value.positionMs)
+        assertEquals(128,state.artworkId)
+        state.accept(Iap2Messages.buildRaw(0x5001) { group(1) { u32(1,52000) } })
+        assertEquals(200000L,state.value.durationMs)
+        assertEquals(52000L,state.value.positionMs)
+        state.accept(Iap2Messages.buildRaw(0x5001) { group(0) { u64(0,2) } })
+        assertNull(state.value.durationMs); assertNull(state.value.positionMs); assertNull(state.artworkId)
+    }
+
+    @Test fun partialUpdatesAndTrackChanges() {
+        val state = NowPlayingState()
+        state.accept(Iap2Messages.buildRaw(0x5001) { group(0) { u64(0,1); string(1,"Song"); string(12,"Artist"); string(6,"Album") } })
+        state.accept(Iap2Messages.buildRaw(0x5001) { group(1) { u8(0,2) } })
+        assertEquals(NowPlaying("Song","Artist","Album"),state.value)
+        state.accept(Iap2Messages.buildRaw(0x5001) { group(0) { string(1,"Updated title") } })
+        assertEquals("Artist",state.value.artist)
+        state.accept(Iap2Messages.buildRaw(0x5001) { group(0) { u64(0,2); string(1,"Next") } })
+        assertEquals(NowPlaying("Next",revision = 1),state.value)
+    }
+}
diff --git a/server/src/test/kotlin/com/playport/server/OemSettingsTest.kt b/server/src/test/kotlin/com/playport/server/OemSettingsTest.kt
new file mode 100644
index 0000000..135c6ab
--- /dev/null
+++ b/server/src/test/kotlin/com/playport/server/OemSettingsTest.kt
@@ -0,0 +1,24 @@
+package com.playport.server
+
+import com.shilapi.xcertplay.airplay.AirPlayInfoPlist
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class OemSettingsTest {
+    @get:Rule val temporary = TemporaryFolder()
+    @Test fun advertisesRealSettingsIconToPhone() {
+        val root = temporary.root.toPath()
+        CarPlayServer(ServerConfig(identityDir = root, stateDir = root.resolve("state"), bindAddress = "127.0.0.1")).use { server ->
+            val info = AirPlayInfoPlist.build(server.airPlayConfig)
+            assertEquals(true, info["oemIconVisible"])
+            assertEquals("设置", info["oemIconLabel"])
+            val icon = (info["oemIcons"] as List<*>).single() as Map<*, *>
+            val bytes = icon["imageData"] as ByteArray
+            assertArrayEquals(byteArrayOf(-119,80,78,71,13,10,26,10), bytes.take(8).toByteArray())
+            assertEquals(180, java.nio.ByteBuffer.wrap(bytes,16,4).int)
+            assertEquals(180, java.nio.ByteBuffer.wrap(bytes,20,4).int)
+        }
+    }
+}
