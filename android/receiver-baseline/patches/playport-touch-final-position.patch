+emit('pointerdown', pointer(1, 300, 162.5));
 flush();
 assert.deepEqual(messages.pop().contacts, [{ id: 0, x: .5, y: .5, down: true }]);
 rect = { left: 100, top: 50, width: 225, height: 400 };
-listeners.get('pointermove')(pointer(1, 212.5, 250));
