# Preserve every unsent final pointer position before release, independent of viewport size.
# The phone owns gesture recognition; do not turn sub-1% drags into down/up-only reports.
diff --git a/web/src/input.ts b/web/src/input.ts
--- a/web/src/input.ts
+++ b/web/src/input.ts
@@ -8,8 +8,8 @@
   x: number;
   y: number;
   down: boolean;
-  startX: number;
-  startY: number;
+  sentX: number;
+  sentY: number;
 }
 
 const emptyKnob = (overrides: Partial<KnobState> = {}): KnobState => ({
@@ -60,7 +60,7 @@
     this.surface.focus({ preventScroll: true });
     this.surface.setPointerCapture(event.pointerId);
     const x = this.normalizeX(event.clientX), y = this.normalizeY(event.clientY);
-    this.pointers.set(event.pointerId, { slot: this.nextSlot(), x, y, down: true, startX: x, startY: y });
+    this.pointers.set(event.pointerId, { slot: this.nextSlot(), x, y, down: true, sentX: x, sentY: y });
     this.flush();
     this.lastDownAt = performance.now();
   };
@@ -82,9 +82,9 @@
     if (event.type === 'pointerup') {
       pointer.x = this.normalizeX(event.clientX);
       pointer.y = this.normalizeY(event.clientY);
-      // A swipe that moved sends its final point as a move before the up: the animation-frame flush can be
-      // starved while the page decodes, and an up alone at the end reads as a tap on the phone (2026-10-23).
-      if (Math.abs(pointer.x - pointer.startX) > 0.01 || Math.abs(pointer.y - pointer.startY) > 0.01) this.flush();
+      // RAF may not have sent the final move yet. Preserve even short drags and returns to the
+      // starting point; gesture thresholds belong to the phone, not to the viewer window size.
+      if (pointer.x !== pointer.sentX || pointer.y !== pointer.sentY) this.flush();
     }
     pointer.down = false;
     this.flush();
@@ -172,6 +172,8 @@
         contacts.push({ id: contacts.length, x: 0, y: 0, down: false });
       }
       contacts[pointer.slot] = { id: pointer.slot, x: pointer.x, y: pointer.y, down: pointer.down };
+      pointer.sentX = pointer.x;
+      pointer.sentY = pointer.y;
     }
     this.send({ type: 'touch', contacts });
   }
diff --git a/web/check.mjs b/web/check.mjs
--- a/web/check.mjs
+++ b/web/check.mjs
@@ -54,37 +54,71 @@
 key('ArrowLeft', new Element('button'));
